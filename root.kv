#:import dp kivy.metrics.dp

# Azul principal y su variante oscura para el tema oscuro
#:set AZUL_CLARO (0.16, 0.45, 0.87, 1)
#:set AZUL_OSCURO (0.05, 0.09, 0.20, 1)

BoxLayout:
    orientation: "vertical"
    canvas.before:
        Color:
            rgba: app.ui.fondo
        Rectangle:
            pos: self.pos
            size: self.size

    ScreenManager:
        id: sm

        CargaScreen:
            name: "carga"

        LoginScreen:
            name: "login"

        RegistroScreen:
            name: "registro"

        HomeScreen:
            name: "home"

        RecorridosScreen:
            name: "recorridos"

        DetalleScreen:
            name: "detalle"

        CompartirScreen:
            name: "compartir"

        AvisosScreen:
            name: "avisos"

        AjustesScreen:
            name: "ajustes"

        PerfilScreen:
            name: "perfil"

    # ----------------------------------------------------------
    # Barra de navegación inferior (oculta en carga, login y registro)
    # ----------------------------------------------------------
    MDBoxLayout:
        id: nav_bar
        size_hint_y: None
        theme_bg_color: "Custom"
        height: 0 if sm.current in ("carga", "login", "registro") else dp(64) + app.safe_bottom
        opacity: 0 if sm.current in ("carga", "login", "registro") else 1
        disabled: sm.current in ("carga", "login", "registro")
        padding: dp(4), dp(4), dp(4), dp(4) + app.safe_bottom
        spacing: dp(4)
        -md_bg_color: app.ui.fondo
        canvas.after:
            Color:
                rgba: app.ui.borde
            Line:
                points: self.x, self.top, self.right, self.top
                width: .7

        NavItem:
            icono_activo: "home"
            icono_inactivo: "home-outline"
            etiqueta: "Inicio"
            activo: sm.current == "home"
            on_release: app.cambiar_pantalla("home")

        NavItem:
            icono_activo: "bus"
            icono_inactivo: "bus-side"
            etiqueta: "Recorridos"
            activo: sm.current in ("recorridos", "detalle")
            on_release: app.cambiar_pantalla("recorridos")

        NavItem:
            icono_activo: "map-marker-radius"
            icono_inactivo: "map-marker-radius-outline"
            etiqueta: "Compartir"
            activo: sm.current == "compartir"
            on_release: app.cambiar_pantalla("compartir")

        NavItem:
            icono_activo: "bell"
            icono_inactivo: "bell-outline"
            etiqueta: "Avisos"
            activo: sm.current == "avisos"
            on_release: app.cambiar_pantalla("avisos")

        NavItem:
            icono_activo: "cog"
            icono_inactivo: "cog-outline"
            etiqueta: "Ajustes"
            activo: sm.current == "ajustes"
            on_release: app.cambiar_pantalla("ajustes")


<NavItem@ButtonBehavior+BoxLayout>:
    icono_activo: ""
    icono_inactivo: ""
    etiqueta: ""
    activo: False
    orientation: "vertical"
    padding: 0, dp(4)

    AnchorLayout:
        anchor_x: "center"
        anchor_y: "center"
        size_hint_y: None
        height: dp(30)

        BoxLayout:
            size_hint: None, None
            size: dp(52), dp(28)

            canvas.before:
                Color:
                    rgba: app.ui.suave if root.activo else (0, 0, 0, 0)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(14)]

            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"

                MDIcon:
                    icon: root.icono_activo if root.activo else root.icono_inactivo
                    icon_color: app.ui.azul if root.activo else app.ui.secundario
                    adaptive_size: True

    AnchorLayout:
        anchor_x: "center"
        anchor_y: "center"
        size_hint_y: None
        height: dp(16)

        MDLabel:
            text: root.etiqueta
            halign: "center"
            font_style: "Label"
            role: "small"
            theme_text_color: "Custom"
            text_color: app.ui.azul if root.activo else app.ui.secundario
            adaptive_size: True


# ----------------------------------------------------------
# Barra superior azul reutilizable (avatar + contenido)
# ----------------------------------------------------------
<TopBar@MDBoxLayout>:
    size_hint_y: None
    height: dp(72)
    padding: dp(12), dp(6), dp(16), dp(6)
    spacing: dp(9)
    theme_bg_color: "Custom"
    -md_bg_color: app.ui.fondo
    canvas.after:
        Color:
            rgba: app.ui.borde
        Line:
            points: self.x, self.y, self.right, self.y
            width: .7

    MDIconButton:
        icon: "account-circle"
        icon_color: app.ui.azul
        pos_hint: {"center_y": 0.5}
        on_release: app.cambiar_pantalla("perfil")
        canvas.before:
            Color:
                rgba: app.ui.suave
            Ellipse:
                pos: self.pos
                size: self.size


<PanelHeader@ButtonBehavior+BoxLayout>:
    orientation: "horizontal"


<LocalidadChip@ButtonBehavior+BoxLayout>:
    orientation: "horizontal"
    padding: dp(14), 0
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: app.ui.suave
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(20)]
        Color:
            rgba: app.ui.borde
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(20))
            width: .7


# ----------------------------------------------------------
# Inicio: mapa con la línea A -> B + panel de buses
# ----------------------------------------------------------
<HomeSurface@UiSurface>:
    -md_bg_color: app.ui.fondo
    -bg: self.md_bg_color
    -stroke: 0, 0, 0, 0
    radius: [dp(16)]
    corners: self.radius
    padding: 0

<HomeText@UiText>:

<HomeIcon@UiIcon>:
    -text_color: app.ui.azul
    -icon_color: self.text_color

<HomeAction@ButtonBehavior+HomeSurface>:
    size_hint: None, None
    size: dp(48), dp(48)
    radius: [dp(24)]

<HomeSelector@ButtonBehavior+BoxLayout>:
    orientation: "vertical"
    padding: dp(12), dp(6)


<HomeScreen>:
    on_size: if app.root: app.ajustar_panel_home()
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: app.ui.fondo
            Rectangle:
                pos: self.pos
                size: self.size

        # Cabecera: identidad breve para dejar espacio al mapa.
        BoxLayout:
            id: home_header
            size_hint_y: None
            height: dp(76)
            padding: dp(18), dp(12), dp(16), dp(8)
            spacing: dp(11)
            HomeSurface:
                size_hint: None, None
                size: dp(44), dp(44)
                pos_hint: {"center_y": .5}
                radius: [dp(14)]
                -md_bg_color: app.ui.suave
                AnchorLayout:
                    HomeIcon:
                        icon: "bus-side"
                        font_size: "25sp"
                        size: dp(29), dp(29)
                        -text_color: app.ui.azul
            BoxLayout:
                orientation: "vertical"
                HomeText:
                    text: "EnRuta Ya!"
                    font_size: "20sp"
                    bold: True
                    -color: app.ui.texto
                HomeText:
                    text: "Rutas de La Araucanía"
                    font_size: "11sp"
                    size_hint_y: None
                    height: dp(18)
                    -color: app.ui.secundario
            HomeAction:
                id: home_perfil
                pos_hint: {"center_y": .5}
                size: dp(44), dp(44)
                radius: [dp(15)]
                -md_bg_color: app.ui.tarjeta
                on_release: app.cambiar_pantalla("perfil")
                AnchorLayout:
                    HomeIcon:
                        icon: "account-circle-outline"
                        font_size: "25sp"
                        -text_color: app.ui.texto

        # Selector de ruta: un solo control visual con dos zonas pulsables.
        BoxLayout:
            id: home_selectors
            size_hint_y: None
            height: dp(80)
            padding: dp(16), dp(2), dp(16), dp(12)
            HomeSurface:
                -md_bg_color: app.ui.tarjeta
                -stroke: app.ui.borde
                radius: [dp(18)]
                padding: dp(3), 0
                HomeSelector:
                    id: origen_btn
                    padding: dp(10), dp(9)
                    on_release: app.abrir_menu_origen(self)
                    HomeText:
                        text: "SALIDA"
                        -color: app.ui.secundario
                        font_size: "9sp"
                        bold: True
                        size_hint_y: None
                        height: dp(16)
                    HomeText:
                        id: origen_text
                        text: "Elegir localidad"
                        -color: app.ui.texto
                        font_size: "12sp"
                        bold: True
                HomeSurface:
                    size_hint: None, None
                    size: dp(32), dp(32)
                    pos_hint: {"center_y": .5}
                    radius: [dp(16)]
                    -md_bg_color: app.ui.fondo
                    AnchorLayout:
                        HomeIcon:
                            icon: "arrow-right"
                            font_size: "18sp"
                            -text_color: app.ui.azul
                HomeSelector:
                    id: recorrido_btn
                    padding: dp(10), dp(9)
                    on_release: app.abrir_recorrido_home(self)
                    HomeText:
                        text: "DESTINO"
                        -color: app.ui.secundario
                        font_size: "9sp"
                        bold: True
                        size_hint_y: None
                        height: dp(16)
                    HomeText:
                        id: recorrido_text
                        text: "Todos los destinos"
                        -color: app.ui.texto
                        font_size: "12sp"
                        bold: True
                HomeIcon:
                    icon: "chevron-down"
                    -text_color: app.ui.secundario
                    size: dp(16), dp(22)
                    font_size: "17sp"
                    pos_hint: {"center_y": .5}

        # Estado de conexión: no bloquea las rutas almacenadas.
        UiSurface:
            id: barra_offline
            size_hint_y: None
            height: dp(32) if not app.en_linea else 0
            opacity: 0 if app.en_linea else 1
            -bg: app.ui.suave
            -stroke: 0, 0, 0, 0
            padding: dp(18), 0
            spacing: dp(9)
            UiIcon:
                icon: "cloud-off-outline"
                size: dp(18), dp(22)
                font_size: "17sp"
                -icon_color: app.ui.rojo
            UiText:
                text: app.texto_conexion
                -color: app.ui.texto
                font_size: "10sp"

        # Mensaje de la configuración remota. Sigue siendo un elemento independiente
        # para que la altura del mapa se ajuste cuando no hay banner.
        BoxLayout:
            id: banner
            size_hint_y: None
            height: dp(30) if banner_texto.text else 0
            padding: dp(20), 0
            spacing: dp(7)
            opacity: 0
            canvas.before:
                Color:
                    rgba: app.ui.suave
                Rectangle:
                    pos: self.pos
                    size: self.size
            HomeIcon:
                icon: "information-outline"
                size: dp(16), dp(20)
                font_size: "14sp"
                -text_color: app.ui.azul
            HomeText:
                id: banner_texto
                text: ""
                -color: app.ui.texto
                font_size: "10sp"

        # El mapa conserva todos los identificadores y eventos originales.
        RelativeLayout:
            id: map_container
            size_hint_y: 1
            MapView:
                id: mapa
                lat: -38.7359
                lon: -72.5904
                zoom: 10
                size_hint: 1, 1

            # Las posiciones y tiempos aún son simulados: aviso destacado.
            HomeSurface:
                id: demo_chip
                size_hint: None, None
                size: dp(192), dp(32)
                pos_hint: {"x": .04}
                y: self.parent.height - self.height - dp(12)
                padding: dp(11), 0
                spacing: dp(7)
                radius: [dp(16)]
                -md_bg_color: app.ui.marino
                HomeIcon:
                    icon: "flask-outline"
                    font_size: "16sp"
                    size: dp(18), dp(20)
                    -text_color: 1, 1, 1, 1
                HomeText:
                    text: "DATOS DE LA COMUNIDAD"
                    -color: 1, 1, 1, 1
                    font_size: "10sp"
                    bold: True

            HomeSurface:
                id: location_chip
                size_hint: None, None
                width: min(dp(242), self.parent.width - dp(32))
                height: dp(32)
                pos_hint: {"x": .04}
                y: self.parent.height - dp(88)
                padding: dp(11), 0
                spacing: dp(7)
                radius: [dp(16)]
                -md_bg_color: app.ui.fondo
                -stroke: app.ui.borde
                HomeIcon:
                    icon: "crosshairs"
                    font_size: "16sp"
                    size: dp(18), dp(20)
                    -text_color: app.ui.azul
                HomeText:
                    id: ubicacion_estado
                    text: "Tu ubicación: sin consultar"
                    -color: app.ui.texto
                    font_size: "10sp"

            HomeAction:
                id: localizar_btn
                pos_hint: {"right": .96}
                y: dp(16)
                radius: [dp(18)]
                -md_bg_color: .157, .404, .910, 1
                on_release: app.localizarme()
                canvas.before:
                    Color:
                        rgba: .07, .17, .28, .15
                    RoundedRectangle:
                        pos: self.x - dp(3), self.y - dp(4)
                        size: self.width + dp(6), self.height + dp(7)
                        radius: [dp(20)]
                AnchorLayout:
                    HomeIcon:
                        icon: "crosshairs-gps"
                        font_size: "24sp"
                        -text_color: 1, 1, 1, 1

        # Panel plegable, más claro y preparado para mostrar las rutas.
        HomeSurface:
            id: panel_buses
            orientation: "vertical"
            size_hint_y: None
            height: dp(48)
            padding: dp(16), 0
            radius: [dp(22), dp(22), 0, 0]
            -md_bg_color: app.ui.fondo

            PanelHeader:
                id: panel_header
                orientation: "vertical"
                size_hint_y: None
                height: dp(48)
                on_release: app.alternar_panel_buses()
                AnchorLayout:
                    size_hint_y: None
                    height: dp(12)
                    Widget:
                        size_hint: None, None
                        size: dp(34), dp(4)
                        canvas:
                            Color:
                                rgba: app.ui.borde
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(3)]
                BoxLayout:
                    spacing: dp(9)
                    HomeIcon:
                        icon: "bus-clock"
                        size: dp(22), dp(22)
                        font_size: "20sp"
                        -text_color: app.ui.azul
                    HomeText:
                        id: lineas_titulo
                        text: "Rutas disponibles"
                        font_size: "15sp"
                        bold: True
                    HomeText:
                        text: "Ver recorridos"
                        font_size: "10sp"
                        halign: "right"
                        -color: app.ui.secundario
                    HomeIcon:
                        id: panel_icono
                        icon: "chevron-up"
                        -text_color: app.ui.azul

            ScrollView:
                id: buses_scroll
                opacity: 1 if panel_buses.height > dp(50) else 0
                disabled: panel_buses.height <= dp(50)
                do_scroll_x: False
                bar_width: dp(2)
                MDBoxLayout:
                    id: lineas_box
                    orientation: "vertical"
                    spacing: dp(10)
                    padding: 0, dp(8), 0, dp(12)
                    adaptive_height: True

<HomeBusCard>:
    style: "outlined"
    orientation: "vertical"
    size_hint_y: None
    height: dp(160)
    padding: dp(12), dp(10)
    spacing: dp(6)
    radius: [dp(16)]
    theme_bg_color: "Custom"
    -md_bg_color: app.ui.tarjeta
    theme_line_color: "Custom"
    -line_color: app.ui.borde
    on_release: app.mostrar_detalle(root.rid)

    BoxLayout:
        size_hint_y: None
        height: dp(36)
        spacing: dp(10)
        HomeSurface:
            size_hint_x: None
            width: dp(36)
            radius: [dp(10)]
            -md_bg_color: .157, .404, .910, .12
            AnchorLayout:
                HomeIcon:
                    icon: "bus-side"
        BoxLayout:
            orientation: "vertical"
            HomeText:
                text: root.ruta.split("->")[0].strip()
                bold: True
                font_size: "14sp"
            BoxLayout:
                spacing: dp(4)
                HomeIcon:
                    icon: "arrow-right"
                    size: dp(16), dp(16)
                    font_size: "14sp"
                HomeText:
                    text: root.ruta.split("->")[-1].strip()
                    font_size: "12sp"
        BoxLayout:
            orientation: "vertical"
            size_hint_x: None
            width: dp(64)
            HomeText:
                text: root.minutos
                font_size: "19sp"
                bold: True
                halign: "right"
                -color: app.ui.azul
            HomeText:
                text: "Tiempo"
                font_size: "9sp"
                halign: "right"
                -color: app.ui.secundario

    HomeSurface:
        size_hint_y: None
        height: dp(25)
        padding: dp(8), 0
        spacing: dp(6)
        radius: [dp(8)]
        -md_bg_color: app.ui.estado(root.aviso_color, app.ui.texto)[:3] + [.10]
        HomeIcon:
            icon: root.estado_icono
            size: dp(16), dp(18)
            font_size: "14sp"
            -text_color: app.ui.estado(root.aviso_color, app.ui.texto)
        HomeText:
            text: root.aviso
            -color: app.ui.estado(root.aviso_color, app.ui.texto)
            font_size: "10sp"
            bold: True
    BoxLayout:
        HomeText:
            text: "Ocupación"
            -color: app.ui.secundario
            font_size: "10sp"
        HomeText:
            text: root.ocupacion
            bold: True
            font_size: "11sp"
            halign: "right"
    HomeText:
        text: root.actualizacion
        -color: app.ui.secundario
        font_size: "10sp"
    HomeText:
        text: "Reportes comunitarios · sin GPS de buses en vivo"
        -color: app.ui.secundario
        font_size: "9sp"



<LineaCard>:
    # Tarjeta de recorrido compartida por Recorridos y Favoritas.
    style: "outlined"
    theme_bg_color: "Custom"
    -md_bg_color: app.ui.fondo
    theme_line_color: "Custom"
    -line_color: app.ui.borde
    orientation: "vertical"
    size_hint_y: None
    height: dp(172)
    radius: [dp(17)]
    padding: dp(14), dp(12)
    spacing: dp(7)
    on_release: app.mostrar_detalle(root.rid)

    BoxLayout:
        size_hint_y: None
        height: dp(45)
        spacing: dp(10)
        UiSurface:
            size_hint: None, None
            size: dp(42), dp(42)
            pos_hint: {"center_y": .5}
            corners: [dp(13)]
            -bg: app.ui.suave
            -stroke: 0, 0, 0, 0
            padding: 0
            AnchorLayout:
                UiIcon:
                    icon: "bus-side"
                    font_size: "23sp"
                    -icon_color: app.ui.azul
        BoxLayout:
            orientation: "vertical"
            UiText:
                text: root.ruta.split("->")[0].strip()
                bold: True
                font_size: "14sp"
            BoxLayout:
                spacing: dp(4)
                UiIcon:
                    icon: "arrow-right"
                    size: dp(16), dp(16)
                    font_size: "14sp"
                    -icon_color: app.ui.azul
                UiText:
                    text: root.ruta.split("->")[-1].strip()
                    font_size: "12sp"
                    -color: app.ui.secundario
        BoxLayout:
            orientation: "vertical"
            size_hint_x: None
            width: dp(76)
            UiText:
                text: root.minutos
                bold: True
                font_size: "18sp"
                -color: app.ui.azul
                halign: "right"
            UiText:
                text: "Tiempo aprox."
                -color: app.ui.secundario
                font_size: "10sp"
                halign: "right"

    UiText:
        text: root.detalle
        font_size: "11sp"
        -color: app.ui.secundario
        size_hint_y: None
        height: dp(20)

    UiSurface:
        size_hint_y: None
        height: dp(30)
        padding: dp(9), 0
        spacing: dp(7)
        corners: [dp(10)]
        -bg: app.ui.suave
        -stroke: 0, 0, 0, 0
        UiIcon:
            icon: "information-outline"
            font_size: "16sp"
            size: dp(18), dp(20)
            -icon_color: app.ui.estado(root.aviso_color, app.ui.texto)
        UiText:
            text: root.aviso
            font_size: "11sp"
            bold: True
            -color: app.ui.estado(root.aviso_color, app.ui.texto)

    BoxLayout:
        size_hint_y: None
        height: dp(22)
        spacing: dp(8)
        UiText:
            text: "Ver detalle y favoritas"
            font_size: "11sp"
            bold: True
            -color: app.ui.azul
        UiIcon:
            icon: "arrow-right"
            size: dp(20), dp(20)
            font_size: "17sp"
            -icon_color: app.ui.azul

<AvisoCard>:
    theme_bg_color: "Custom"
    -md_bg_color: app.ui.tarjeta
    style: "outlined"
    orientation: "horizontal"
    size_hint_y: None
    height: dp(112)
    padding: dp(12), dp(8)
    spacing: dp(10)
    radius: [dp(18)]

    MDIcon:
        icon: root.icono
        theme_text_color: "Custom"
        text_color: root.color
        size_hint_x: None
        width: dp(32)
        pos_hint: {"center_y": 0.5}

    BoxLayout:
        orientation: "vertical"

        MDLabel:
            text: root.titulo
            bold: True
            font_style: "Body"
            role: "medium"
            theme_text_color: "Custom"
            text_color: root.color

        MDLabel:
            text: root.detalle
            font_style: "Body"
            role: "small"

        MDLabel:
            text: (root.autor + " · " + root.nivel) if root.autor else ""
            font_style: "Body"
            role: "small"
            theme_text_color: "Secondary"

        BoxLayout:
            size_hint_y: None
            height: dp(32)
            spacing: dp(2)

            MDLabel:
                text: "¿Es correcto?"
                font_style: "Body"
                role: "small"
                size_hint_x: None
                width: dp(90)

            MDIconButton:
                icon: "thumb-up" if root.mi_voto == 1 else "thumb-up-outline"
                style: "standard"
                size_hint: None, None
                size: dp(32), dp(32)
                disabled: root.propio
                on_release: app.votar_aviso(root.aviso_id, 1)

            MDLabel:
                text: str(root.votos_ok)
                size_hint_x: None
                width: dp(28)

            MDIconButton:
                icon: "thumb-down" if root.mi_voto == -1 else "thumb-down-outline"
                style: "standard"
                size_hint: None, None
                size: dp(32), dp(32)
                disabled: root.propio
                on_release: app.votar_aviso(root.aviso_id, -1)

            MDLabel:
                text: str(root.votos_mal)


<DatoRuta@MDCard>:
    icono: ""
    titulo: ""
    valor: ""
    style: "outlined"
    orientation: "vertical"
    size_hint_y: None
    height: dp(88)
    padding: dp(8)
    radius: [dp(18)]

    MDIcon:
        icon: root.icono
        halign: "center"
        size_hint_y: None
        height: dp(28)

    MDLabel:
        text: root.valor
        halign: "center"
        bold: True
        font_style: "Body"
        role: "small"

    MDLabel:
        text: root.titulo
        halign: "center"
        font_style: "Body"
        role: "small"
        theme_text_color: "Secondary"


# ----------------------------------------------------------
# Detalle de un recorrido
# ----------------------------------------------------------
<DetalleScreen>:
    BoxLayout:
        orientation: "vertical"

        MDBoxLayout:
            size_hint_y: None
            height: dp(58)
            padding: dp(6), 0
            spacing: dp(6)
            md_bg_color: app.ui.marino

            MDIconButton:
                icon: "arrow-left"
                icon_color: 1, 1, 1, 1
                pos_hint: {"center_y": 0.5}
                on_release: app.cerrar_detalle()

            MDLabel:
                text: "Detalle del recorrido"
                bold: True
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                pos_hint: {"center_y": 0.5}

        # Mapa con la línea punto A -> punto B (fuera del scroll para poder moverlo)
        MapView:
            id: mapa_detalle
            lat: -38.7359
            lon: -72.5904
            zoom: 10
            size_hint_y: None
            height: dp(200)

        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(12)
                padding: dp(12)
                adaptive_height: True

                # --- Cabecera: nombre, A -> B y estado de verificación ---
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(104)
                    padding: dp(16)
                    spacing: dp(10)
                    radius: [18]
                    md_bg_color: app.ui.marino

                    MDIcon:
                        icon: "bus"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        size_hint_x: None
                        width: dp(40)
                        pos_hint: {"center_y": 0.5}

                    BoxLayout:
                        orientation: "vertical"

                        MDLabel:
                            id: det_titulo
                            text: ""
                            bold: True
                            font_style: "Title"
                            role: "medium"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                        MDLabel:
                            id: det_ruta_texto
                            text: ""
                            font_style: "Body"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 0.9

                        MDLabel:
                            id: det_parada
                            text: ""
                            font_style: "Body"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 0.75

                    MDLabel:
                        id: det_ver
                        text: ""
                        halign: "right"
                        bold: True
                        size_hint_x: None
                        width: dp(96)
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 0.85

                # --- Frecuencia, duración y tarifa ---
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(88)
                    spacing: dp(8)

                    DatoRuta:
                        id: det_frecuencia
                        icono: "timer-sand"
                        titulo: "Frecuencia"

                    DatoRuta:
                        id: det_duracion
                        icono: "clock-outline"
                        titulo: "Duración"

                    DatoRuta:
                        id: det_tarifa
                        icono: "cash"
                        titulo: "Tarifa"

                # --- ¿Este recorrido es real? (votación) ---
                MDCard:
                    theme_bg_color: "Custom"
                    -md_bg_color: app.ui.tarjeta
                    style: "outlined"
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(124)
                    padding: dp(14), dp(8)
                    radius: [dp(18)]

                    MDLabel:
                        text: "¿Este recorrido es real?"
                        bold: True
                        size_hint_y: None
                        height: dp(28)

                    BoxLayout:
                        size_hint_y: None
                        height: dp(44)
                        spacing: dp(6)

                        MDIconButton:
                            id: det_like
                            icon: "thumb-up-outline"
                            style: "tonal"
                            pos_hint: {"center_y": 0.5}
                            on_release: app.votar_recorrido(1)

                        MDLabel:
                            id: det_n_ok
                            text: "0"
                            size_hint_x: None
                            width: dp(36)
                            bold: True

                        MDIconButton:
                            id: det_dislike
                            icon: "thumb-down-outline"
                            style: "tonal"
                            pos_hint: {"center_y": 0.5}
                            on_release: app.votar_recorrido(-1)

                        MDLabel:
                            id: det_n_mal
                            text: "0"
                            bold: True

                    MDLabel:
                        id: det_confianza
                        text: ""
                        font_style: "Body"
                        role: "small"

                # --- Estado actual según los avisos ---
                MDCard:
                    theme_bg_color: "Custom"
                    -md_bg_color: app.ui.tarjeta
                    style: "outlined"
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(60)
                    padding: dp(14), dp(8)
                    spacing: dp(10)
                    radius: [dp(18)]

                    MDIcon:
                        icon: "information-outline"
                        size_hint_x: None
                        width: dp(28)
                        pos_hint: {"center_y": 0.5}

                    BoxLayout:
                        orientation: "vertical"

                        MDLabel:
                            text: "Estado ahora"
                            font_style: "Body"
                            role: "small"

                        MDLabel:
                            id: det_estado
                            text: ""
                            bold: True
                            font_style: "Body"
                            role: "medium"
                            theme_text_color: "Custom"
                            text_color: 0.5, 0.52, 0.58, 1

                MDButton:
                    style: "tonal"
                    size_hint_y: None
                    height: dp(44)
                    pos_hint: {"center_x": 0.5}
                    on_release: app.alternar_favorita(app.id_detalle)

                    MDButtonIcon:
                        id: det_fav_icono
                        icon: "star-outline"

                    MDButtonText:
                        id: det_fav_texto
                        text: "Agregar a favoritas"

                # --- Avisos de este recorrido, con votos ---
                MDLabel:
                    text: "Avisos recientes de este recorrido"
                    bold: True
                    font_style: "Title"
                    role: "small"
                    size_hint_y: None
                    height: dp(28)

                MDLabel:
                    text: "Vota si cada aviso es correcto: así sube la confianza de quienes informan bien."
                    font_style: "Body"
                    role: "small"
                    size_hint_y: None
                    height: dp(36)

                MDLabel:
                    id: det_vacio
                    text: "Aún no hay avisos para este recorrido."
                    font_style: "Body"
                    role: "small"
                    size_hint_y: None
                    height: dp(40)

                MDBoxLayout:
                    id: det_avisos_box
                    orientation: "vertical"
                    spacing: dp(8)
                    adaptive_height: True


# ----------------------------------------------------------
# Recorridos
# ----------------------------------------------------------
<RecorridosScreen>:
    BoxLayout:
        orientation: "vertical"
        UiHeader:
            titulo: "Recorridos"
            subtitulo: "Conexiones de La Araucanía"
        UiScroll:
            UiBody:
                UiJourneyHero:
                    etiqueta: "01  /  EXPLORAR"
                    titulo: "¿Hacia dónde vamos?"
                    descripcion: "Encuentra las rutas de la región y elige tu próxima conexión."
                    icono: "routes"
                UiNotice:
                    text: "Horarios, tarifas y tiempos referenciales. Las rutas pueden ser aportadas por usuarios; revisa su estado de verificación."
                    icon: "information-outline"
                BoxLayout:
                    size_hint_y: None
                    height: dp(36)
                    spacing: dp(8)
                    UiIcon:
                        icon: "bus-multiple"
                        size: dp(24), dp(24)
                        font_size: "21sp"
                        -icon_color: app.ui.azul
                    UiSection:
                        text: "Rutas disponibles"
                    UiIcon:
                        icon: "arrow-down"
                        font_size: "17sp"
                        -icon_color: app.ui.secundario
                UiParagraph:
                    id: recorridos_resumen
                    text: ""
                    font_size: "11sp"
                MDBoxLayout:
                    id: recorridos_box
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(12)

<CompartirScreen>:
    BoxLayout:
        orientation: "vertical"
        UiHeader:
            titulo: "Compartir viaje"
            subtitulo: "El control de tu ubicación es tuyo"
        UiScroll:
            UiBody:
                UiJourneyHero:
                    etiqueta: "02  /  COLABORAR"
                    titulo: "Viaja y ayuda a otros"
                    descripcion: "Activa tu ubicación voluntariamente y comparte el estado de tu recorrido."
                    icono: "map-marker-radius-outline"
                UiNotice:
                    text: "Tu ubicación GPS se utiliza localmente con permiso. Los avisos sí se comparten mediante el servidor."
                    icon: "shield-check-outline"

                BoxLayout:
                    size_hint_y: None
                    height: dp(35)
                    spacing: dp(9)
                    UiSurface:
                        size_hint: None, None
                        size: dp(30), dp(30)
                        corners: [dp(10)]
                        -bg: app.ui.suave
                        -stroke: 0, 0, 0, 0
                        padding: 0
                        AnchorLayout:
                            UiIcon:
                                icon: "numeric-1-circle-outline"
                                font_size: "21sp"
                                -icon_color: app.ui.azul
                    UiSection:
                        text: "Elige tu línea"
                UiAction:
                    id: linea_btn
                    height: dp(58)
                    corners: [dp(15)]
                    -bg: app.ui.fondo
                    -stroke: app.ui.borde
                    on_release: app.abrir_menu_linea(self)
                    UiIcon:
                        icon: "bus-side"
                        -icon_color: app.ui.azul
                    UiText:
                        id: linea_text
                        text: "Elegir mi línea"
                        bold: True
                        font_size: "13sp"
                    UiIcon:
                        icon: "chevron-down"
                        -icon_color: app.ui.secundario
                UiError:
                    id: linea_error
                    text: ""
                UiSection:
                    text: "Identifica tu viaje"
                UiParagraph:
                    text: "Indica la patente del bus o agenda tu recorrido para iniciar el viaje."
                    font_size: "11sp"
                UiField:
                    id: patente_field
                    MDTextFieldLeadingIcon:
                        icon: "card-text-outline"
                    MDTextFieldHintText:
                        text: "Patente del bus (AB1234 o BCDF12)"
                UiField:
                    id: agenda_field
                    MDTextFieldLeadingIcon:
                        icon: "calendar-clock-outline"
                    MDTextFieldHintText:
                        text: "Agendar viaje: DD/MM HH:MM (opcional)"
                UiError:
                    id: patente_error
                    text: ""

                BoxLayout:
                    size_hint_y: None
                    height: dp(35)
                    spacing: dp(9)
                    UiSurface:
                        size_hint: None, None
                        size: dp(30), dp(30)
                        corners: [dp(10)]
                        -bg: app.ui.suave
                        -stroke: 0, 0, 0, 0
                        padding: 0
                        AnchorLayout:
                            UiIcon:
                                icon: "numeric-2-circle-outline"
                                font_size: "21sp"
                                -icon_color: app.ui.azul
                    UiSection:
                        text: "Inicia tu viaje"
                UiAction:
                    id: compartir_btn
                    height: dp(54)
                    corners: [dp(15)]
                    -bg: (.72, .16, .16, 1) if app.compartiendo else (.157, .404, .910, 1)
                    on_release: app.alternar_compartir()
                    UiIcon:
                        icon: "stop-circle-outline" if app.compartiendo else "map-marker-radius-outline"
                        -icon_color: 1, 1, 1, 1
                    UiText:
                        id: compartir_btn_text
                        text: "INICIAR VIAJE"
                        -color: 1, 1, 1, 1
                        bold: True
                        halign: "center"
                        font_size: "12sp"
                    UiIcon:
                        icon: "arrow-right" if not app.compartiendo else "close-circle-outline"
                        -icon_color: 1, 1, 1, 1
                UiSurface:
                    size_hint_y: None
                    height: max(dp(70), estado_label.texture_size[1] + dp(34))
                    corners: [dp(15)]
                    -bg: app.ui.suave if app.compartiendo else app.ui.tarjeta
                    -stroke: 0, 0, 0, 0
                    UiIcon:
                        icon: "broadcast" if app.compartiendo else "map-marker-off-outline"
                        -icon_color: app.ui.exito if app.compartiendo else app.ui.secundario
                    UiParagraph:
                        id: estado_label
                        text: "Tu ubicación no se está compartiendo."
                        -color: app.ui.texto
                        font_size: "12sp"
                        pos_hint: {"center_y": .5}
                UiParagraph:
                    text: "Puedes detener el viaje cuando quieras. Tu consentimiento es necesario para iniciar."
                    font_size: "11sp"

                BoxLayout:
                    size_hint_y: None
                    height: dp(35)
                    spacing: dp(9)
                    UiSurface:
                        size_hint: None, None
                        size: dp(30), dp(30)
                        corners: [dp(10)]
                        -bg: app.ui.suave
                        -stroke: 0, 0, 0, 0
                        padding: 0
                        AnchorLayout:
                            UiIcon:
                                icon: "numeric-3-circle-outline"
                                font_size: "21sp"
                                -icon_color: app.ui.azul
                    UiSection:
                        text: "Reporta lo que ocurre"
                UiParagraph:
                    text: "Reporta lo que ocurre. Los demás pasajeros podrán valorar tu aviso."
                    font_size: "11sp"
                GridLayout:
                    cols: 1 if self.width < dp(290) else 2
                    size_hint_y: None
                    height: dp(222) if self.cols == 1 else dp(108)
                    spacing: dp(10)
                    UiButton:
                        primary: False
                        text: "Bus lleno"
                        -tinta: app.ui.rojo
                        icon: "account-group-outline"
                        on_release: app.enviar_aviso("lleno")
                    UiButton:
                        primary: False
                        text: "Hay asientos"
                        -tinta: app.ui.exito
                        icon: "seat-passenger"
                        on_release: app.enviar_aviso("asientos")
                    UiButton:
                        primary: False
                        text: "Atraso"
                        -tinta: app.ui.aviso
                        icon: "clock-alert-outline"
                        on_release: app.abrir_menu_atraso(self)
                    UiButton:
                        primary: False
                        text: "Desvío"
                        -tinta: app.ui.aviso
                        icon: "map-marker-alert-outline"
                        on_release: app.enviar_aviso("cambio_ruta")

<AvisosScreen>:
    BoxLayout:
        orientation: "vertical"
        UiHeader:
            titulo: "Avisos"
            subtitulo: "Novedades en tus recorridos"
        UiScroll:
            UiBody:
                UiJourneyHero:
                    etiqueta: "03  /  COMUNIDAD"
                    titulo: "Mantente al tanto"
                    descripcion: "Consulta reportes de ocupación, atrasos y cambios de ruta."
                    icono: "bell-badge-outline"
                UiNotice:
                    text: "Reportes de pasajeros sincronizados con el servidor; no reemplazan avisos oficiales."
                    icon: "flask-outline"
                UiSurface:
                    size_hint_y: None
                    height: dp(70)
                    corners: [dp(16)]
                    -bg: app.ui.fondo
                    -stroke: app.ui.borde
                    UiSurface:
                        size_hint: None, None
                        size: dp(36), dp(36)
                        pos_hint: {"center_y": .5}
                        padding: 0
                        corners: [dp(12)]
                        -bg: app.ui.suave
                        -stroke: 0, 0, 0, 0
                        AnchorLayout:
                            UiIcon:
                                icon: "star-outline"
                                font_size: "20sp"
                                -icon_color: app.ui.azul
                    BoxLayout:
                        orientation: "vertical"
                        UiText:
                            text: "Solo mis favoritas"
                            -color: app.ui.texto
                            bold: True
                            font_size: "13sp"
                        UiText:
                            text: "Filtra los reportes por tus rutas"
                            -color: app.ui.secundario
                            font_size: "10sp"
                    UiSwitch:
                        id: filtro_favoritas
                        on_active: app.alternar_solo_favoritas(self.active)
                BoxLayout:
                    size_hint_y: None
                    height: dp(34)
                    spacing: dp(8)
                    UiIcon:
                        icon: "history"
                        size: dp(23), dp(23)
                        font_size: "20sp"
                        -icon_color: app.ui.azul
                    UiSection:
                        text: "Reportes recientes"
                UiParagraph:
                    text: "Los reportes vencidos se mantienen en el historial hasta 2 horas."
                    font_size: "11sp"
                UiParagraph:
                    id: avisos_vacio
                    -height: dp(40)
                    text: ""
                MDBoxLayout:
                    id: avisos_box
                    adaptive_height: True
                    orientation: "vertical"
                    spacing: dp(12)

<AjustesScreen>:
    BoxLayout:
        orientation: "vertical"
        UiHeader:
            titulo: "Ajustes"
            subtitulo: "Personaliza tu experiencia"
        UiScroll:
            UiBody:
                UiJourneyHero:
                    etiqueta: "04  /  PREFERENCIAS"
                    titulo: "Viaja a tu manera"
                    descripcion: "Controla cómo se ve la aplicación y qué novedades quieres recibir."
                    icono: "tune-variant"

                UiSection:
                    text: "Tu experiencia"
                UiSurface:
                    size_hint_y: None
                    height: dp(76)
                    corners: [dp(17)]
                    -bg: app.ui.fondo
                    -stroke: app.ui.borde
                    UiSurface:
                        size_hint: None, None
                        size: dp(38), dp(38)
                        pos_hint: {"center_y": .5}
                        corners: [dp(13)]
                        -bg: app.ui.suave
                        -stroke: 0, 0, 0, 0
                        padding: 0
                        AnchorLayout:
                            UiIcon:
                                icon: "weather-night"
                                font_size: "21sp"
                                -icon_color: app.ui.azul
                    BoxLayout:
                        orientation: "vertical"
                        UiText:
                            text: "Modo oscuro"
                            bold: True
                            font_size: "13sp"
                        UiText:
                            text: "Diseño cómodo para la noche"
                            -color: app.ui.secundario
                            font_size: "10sp"
                    UiSwitch:
                        id: switch_tema
                        on_active: app.cambiar_tema(self.active)

                UiSurface:
                    size_hint_y: None
                    height: dp(82)
                    corners: [dp(17)]
                    -bg: app.ui.fondo
                    -stroke: app.ui.borde
                    UiSurface:
                        size_hint: None, None
                        size: dp(38), dp(38)
                        pos_hint: {"center_y": .5}
                        corners: [dp(13)]
                        -bg: app.ui.suave
                        -stroke: 0, 0, 0, 0
                        padding: 0
                        AnchorLayout:
                            UiIcon:
                                icon: "bell-outline"
                                font_size: "21sp"
                                -icon_color: app.ui.azul
                    BoxLayout:
                        orientation: "vertical"
                        UiText:
                            text: "Notificaciones"
                            bold: True
                            font_size: "13sp"
                        UiParagraph:
                            text: "Avisos locales sobre tus rutas favoritas"
                            font_size: "10sp"
                    UiSwitch:
                        id: switch_notif
                        active: True
                        on_active: app.cambiar_notificaciones(self.active)

                UiSection:
                    text: "Privacidad"
                UiSurface:
                    size_hint_y: None
                    height: dp(84)
                    corners: [dp(17)]
                    -bg: app.ui.fondo
                    -stroke: app.ui.borde
                    UiIcon:
                        icon: "shield-check-outline"
                        -icon_color: app.ui.azul
                    BoxLayout:
                        orientation: "vertical"
                        UiText:
                            text: "Ayudar a mejorar la app"
                            bold: True
                            font_size: "13sp"
                        UiParagraph:
                            id: mjv_estado
                            text: "Métricas anónimas desactivadas"
                            font_size: "10sp"
                    UiSwitch:
                        id: switch_metricas
                        on_active: app.cambiar_analitica(self.active)

                UiSection:
                    text: "Avisos de la comunidad"
                UiSurface:
                    orientation: "vertical"
                    size_hint_y: None
                    height: max(dp(135), conexion_estado.height + dp(91))
                    corners: [dp(17)]
                    -bg: app.ui.tarjeta
                    -stroke: app.ui.borde
                    spacing: dp(8)
                    BoxLayout:
                        size_hint_y: None
                        height: dp(30)
                        spacing: dp(8)
                        UiIcon:
                            icon: "cloud-check-outline"
                            font_size: "20sp"
                            -icon_color: app.ui.azul
                        UiText:
                            text: "Estado de sincronización"
                            bold: True
                            font_size: "13sp"
                    UiParagraph:
                        id: conexion_estado
                        text: "Comprobando conexión…"
                        -color: app.ui.texto
                        font_size: "11sp"
                    UiButton:
                        primary: False
                        text: "Actualizar avisos"
                        icon: "refresh"
                        on_release: app.sincronizar(manual=True, completo=True)

                UiSection:
                    text: "Información de la app"
                UiSurface:
                    orientation: "vertical"
                    size_hint_y: None
                    height: max(dp(173), cfg_estado.height + dp(110))
                    corners: [dp(17)]
                    -bg: app.ui.tarjeta
                    -stroke: app.ui.borde
                    spacing: dp(9)
                    BoxLayout:
                        size_hint_y: None
                        height: dp(29)
                        spacing: dp(8)
                        UiIcon:
                            icon: "cloud-check-outline"
                            size: dp(21), dp(21)
                            font_size: "19sp"
                            -icon_color: app.ui.azul
                        UiText:
                            text: "Configuración remota"
                            bold: True
                            font_size: "13sp"
                    UiParagraph:
                        id: cfg_estado
                        text: "Consultando configuración…"
                        -color: app.ui.texto
                        font_size: "11sp"
                    UiButton:
                        primary: False
                        text: "Actualizar configuración"
                        icon: "refresh"
                        on_release: app.actualizar_config_remota()

                UiSection:
                    text: "Tu sesión"
                UiAction:
                    height: dp(52)
                    corners: [dp(15)]
                    -bg: app.ui.tarjeta
                    -stroke: app.ui.borde
                    on_release: app.cerrar_sesion()
                    UiIcon:
                        icon: "logout"
                        -icon_color: app.ui.rojo
                    UiText:
                        id: cerrar_texto
                        text: "Cerrar sesión"
                        bold: True
                        font_size: "12sp"
                        -color: app.ui.rojo
                    UiIcon:
                        icon: "arrow-right"
                        -icon_color: app.ui.rojo
                UiText:
                    text: "EnRuta Ya!  ·  Versión 3.0"
                    font_size: "10sp"
                    halign: "center"
                    -color: app.ui.secundario
                    size_hint_y: None
                    height: dp(30)

<PerfilScreen>:
    BoxLayout:
        orientation: "vertical"
        UiHeader:
            titulo: "Mi perfil"
            subtitulo: "Tu espacio en EnRuta Ya!"
        UiScroll:
            UiBody:
                # Identidad del pasajero: misma estética azul marino del Login.
                UiSurface:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(148)
                    corners: [dp(20)]
                    -bg: app.ui.marino
                    -stroke: 0, 0, 0, 0
                    spacing: dp(9)
                    UiText:
                        text: "MI CUENTA  /  VIAJERO"
                        font_size: "10sp"
                        bold: True
                        -color: .71, .84, 1, 1
                        size_hint_y: None
                        height: dp(24)
                    BoxLayout:
                        spacing: dp(13)
                        UiAvatar:
                            size: dp(54), dp(54)
                            pos_hint: {"center_y": .5}
                            corners: [dp(17)]
                        BoxLayout:
                            orientation: "vertical"
                            UiText:
                                id: nombre_label
                                text: "Usuario"
                                bold: True
                                font_size: "21sp"
                                -color: 1, 1, 1, 1
                            UiText:
                                id: usuario_label
                                text: ""
                                -color: .76, .87, 1, 1
                                font_size: "12sp"
                    UiParagraph:
                        text: "Tus recorridos y preferencias, en un solo lugar."
                        -color: .86, .92, 1, 1
                        font_size: "11sp"

                UiSurface:
                    size_hint_y: None
                    height: dp(84)
                    corners: [dp(18)]
                    -bg: app.ui.tarjeta
                    -stroke: app.ui.borde
                    UiSurface:
                        size_hint: None, None
                        size: dp(44), dp(44)
                        pos_hint: {"center_y": .5}
                        corners: [dp(14)]
                        -bg: app.ui.suave
                        -stroke: 0, 0, 0, 0
                        padding: 0
                        AnchorLayout:
                            UiIcon:
                                id: nivel_icono
                                icon: "account-outline"
                                font_size: "24sp"
                                -icon_color: app.ui.azul
                    BoxLayout:
                        orientation: "vertical"
                        UiText:
                            id: nivel_label
                            text: "Novato · 0 puntos"
                            bold: True
                            font_size: "14sp"
                        UiParagraph:
                            id: nivel_falta
                            text: ""
                            font_size: "11sp"

                UiSection:
                    text: "Tu actividad"
                BoxLayout:
                    size_hint_y: None
                    height: dp(92)
                    spacing: dp(11)
                    UiSurface:
                        orientation: "vertical"
                        corners: [dp(17)]
                        -bg: app.ui.suave
                        -stroke: 0, 0, 0, 0
                        padding: dp(13), dp(10)
                        spacing: dp(2)
                        UiText:
                            id: viajes_num
                            text: "0"
                            font_size: "25sp"
                            bold: True
                            -color: app.ui.azul
                        UiText:
                            text: "Viajes compartidos"
                            font_size: "10sp"
                            -color: app.ui.secundario
                    UiSurface:
                        orientation: "vertical"
                        corners: [dp(17)]
                        -bg: app.ui.tarjeta
                        -stroke: app.ui.borde
                        padding: dp(13), dp(10)
                        spacing: dp(2)
                        UiText:
                            id: fav_num
                            text: "0"
                            font_size: "25sp"
                            bold: True
                            -color: app.ui.azul
                        UiText:
                            text: "Rutas favoritas"
                            font_size: "10sp"
                            -color: app.ui.secundario

                UiSection:
                    text: "Datos personales"
                MDBoxLayout:
                    id: perfil_editable
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(112)
                    spacing: dp(8)
                    UiField:
                        id: nombre_field
                        on_text_validate: app.guardar_nombre(self)
                        MDTextFieldHintText:
                            text: "Cambiar nombre (máx. 30 caracteres)"
                        MDTextFieldHelperText:
                            text: "Nombre de hasta 30 caracteres"
                            mode: "on_error"
                    UiButton:
                        primary: False
                        text: "Guardar nombre"
                        icon: "content-save-check-outline"
                        height: dp(44)
                        on_release: app.guardar_nombre(nombre_field)

                UiSection:
                    text: "Privacidad"
                UiSurface:
                    size_hint_y: None
                    height: dp(92)
                    corners: [dp(17)]
                    -bg: app.ui.tarjeta
                    -stroke: app.ui.borde
                    UiIcon:
                        icon: "shield-account-outline"
                        -icon_color: app.ui.azul
                    UiParagraph:
                        text: "Permitir ubicación en viajes. Puedes desactivar esta preferencia cuando quieras."
                        -color: app.ui.texto
                        font_size: "11sp"
                        pos_hint: {"center_y": .5}
                    UiSwitch:
                        id: switch_consent
                        on_active: app.cambiar_consentimiento(self.active)

                UiSection:
                    text: "Rutas que guardaste"
                UiParagraph:
                    id: fav_vacio
                    -height: dp(40)
                    text: "Aún no tienes favoritas. Abre un recorrido y guárdalo desde su detalle."
                MDBoxLayout:
                    id: fav_box
                    adaptive_height: True
                    orientation: "vertical"
                    spacing: dp(12)

<CargaScreen>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: app.ui.marino
            Rectangle:
                pos: self.pos
                size: self.size
        AnchorLayout:
            anchor_x: "center"
            anchor_y: "center"
            BoxLayout:
                orientation: "vertical"
                spacing: dp(13)
                size_hint: None, None
                size: min(dp(340), self.parent.width - dp(35)), dp(245)
                AnchorLayout:
                    size_hint_y: None
                    height: dp(70)
                    UiIcon:
                        icon: "bus-side"
                        font_size: "60sp"
                        -icon_color: 1, 1, 1, 1
                UiText:
                    text: "EnRuta Ya!"
                    bold: True
                    font_size: "30sp"
                    halign: "center"
                    -color: 1, 1, 1, 1
                UiParagraph:
                    text: "Tu viaje comienza aquí"
                    halign: "center"
                    font_size: "13sp"
                    -color: .77, .85, 1, 1
                Widget:
                    size_hint_y: None
                    height: dp(8)
                UiParagraph:
                    id: carga_estado
                    text: "Preparando la aplicación…"
                    halign: "center"
                    font_size: "12sp"
                    -color: .95, .97, 1, 1

<LoginScreen>:
    UiScroll:
        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            # Hero azul marino: marca y propósito antes del formulario.
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: dp(238)
                padding: dp(24), dp(21), dp(24), dp(20)
                spacing: dp(12)
                canvas.before:
                    Color:
                        rgba: app.ui.marino
                    Rectangle:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: .20, .43, .85, .28
                    Ellipse:
                        pos: self.right - dp(170), self.top - dp(165)
                        size: dp(186), dp(186)
                    Color:
                        rgba: .44, .70, 1, .16
                    Ellipse:
                        pos: self.right - dp(113), self.top - dp(218)
                        size: dp(126), dp(126)
                BoxLayout:
                    size_hint_y: None
                    height: dp(44)
                    spacing: dp(11)
                    UiSurface:
                        size_hint: None, None
                        size: dp(44), dp(44)
                        corners: [dp(14)]
                        -bg: .157, .404, .910, 1
                        -stroke: 0, 0, 0, 0
                        padding: 0
                        AnchorLayout:
                            UiIcon:
                                icon: "bus-side"
                                font_size: "27sp"
                                size: dp(30), dp(30)
                                -icon_color: 1, 1, 1, 1
                    BoxLayout:
                        orientation: "vertical"
                        UiText:
                            text: "EnRuta Ya!"
                            font_size: "19sp"
                            bold: True
                            -color: 1, 1, 1, 1
                        UiText:
                            text: "RUTAS DE LA ARAUCANÍA"
                            font_size: "9sp"
                            bold: True
                            -color: .72, .83, 1, 1
                Widget:
                    size_hint_y: None
                    height: dp(2)
                UiText:
                    text: "Tu próximo viaje\ncomienza aquí."
                    shorten: False
                    font_size: "27sp"
                    bold: True
                    size_hint_y: None
                    height: dp(74)
                    -color: 1, 1, 1, 1
                UiParagraph:
                    text: "Encuentra tus recorridos, consulta el mapa y viaja mejor informado."
                    -color: .85, .90, .99, 1
                    font_size: "11sp"

            # Tarjeta de acceso: conserva los IDs utilizados en main.py.
            AnchorLayout:
                size_hint_y: None
                height: login_card.height + dp(38)
                UiSurface:
                    id: login_card
                    orientation: "vertical"
                    size_hint: None, None
                    width: min(dp(430), self.parent.width - dp(24))
                    height: self.minimum_height
                    corners: [dp(20)]
                    -bg: app.ui.fondo
                    -stroke: app.ui.borde
                    padding: dp(20), dp(22)
                    spacing: dp(10)

                    UiSection:
                        text: "¡Qué bueno verte!"
                        font_size: "21sp"
                        height: dp(32)
                    UiParagraph:
                        text: "Ingresa a tu cuenta para continuar tu viaje."
                        font_size: "12sp"

                    UiText:
                        text: "CORREO ELECTRÓNICO"
                        bold: True
                        font_size: "10sp"
                        -color: app.ui.secundario
                        size_hint_y: None
                        height: dp(23)
                    UiField:
                        id: usuario
                        on_text_validate: clave.focus = True
                        MDTextFieldLeadingIcon:
                            icon: "account-outline"
                        MDTextFieldHintText:
                            text: "correo@ejemplo.com"
                    UiError:
                        id: err_usuario
                        text: ""

                    UiText:
                        text: "CONTRASEÑA"
                        bold: True
                        font_size: "10sp"
                        -color: app.ui.secundario
                        size_hint_y: None
                        height: dp(23)
                    UiField:
                        id: clave
                        password: True
                        on_text_validate: app.hacer_login()
                        MDTextFieldLeadingIcon:
                            icon: "lock-outline"
                        MDTextFieldHintText:
                            text: "Tu contraseña"
                    UiError:
                        id: err_general
                        text: ""

                    UiButton:
                        id: ingresar_btn
                        text: "Entrar a EnRuta"
                        icon: "arrow-right"
                        on_release: app.hacer_login()

                    UiButton:
                        primary: False
                        text: "Continuar como invitado"
                        icon: "account-outline"
                        on_release: app.entrar_invitado()

                    UiText:
                        text: "¿Aún no tienes cuenta?"
                        font_size: "11sp"
                        halign: "center"
                        -color: app.ui.secundario
                        size_hint_y: None
                        height: dp(26)
                    UiButton:
                        primary: False
                        text: "Crear cuenta gratis"
                        icon: "account-plus-outline"
                        on_release: app.cambiar_pantalla("registro")

                    UiNotice:
                        text: "Tu ubicación no se comparte. Los avisos se sincronizan automáticamente tras iniciar sesión."
                        icon: "shield-check-outline"

<RegistroScreen>:
    UiScroll:
        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            # Bienvenida compacta, hermana visual del Login.
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: dp(184)
                padding: dp(24), dp(21), dp(24), dp(17)
                spacing: dp(10)
                canvas.before:
                    Color:
                        rgba: app.ui.marino
                    Rectangle:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: .20, .43, .85, .28
                    Ellipse:
                        pos: self.right - dp(160), self.top - dp(155)
                        size: dp(182), dp(182)
                BoxLayout:
                    size_hint_y: None
                    height: dp(42)
                    spacing: dp(11)
                    UiSurface:
                        size_hint: None, None
                        size: dp(42), dp(42)
                        corners: [dp(14)]
                        -bg: .157, .404, .910, 1
                        -stroke: 0, 0, 0, 0
                        padding: 0
                        AnchorLayout:
                            UiIcon:
                                icon: "bus-side"
                                font_size: "25sp"
                                -icon_color: 1, 1, 1, 1
                    UiText:
                        text: "EnRuta Ya!"
                        font_size: "19sp"
                        bold: True
                        -color: 1, 1, 1, 1
                UiText:
                    text: "Únete a la ruta."
                    font_size: "26sp"
                    bold: True
                    size_hint_y: None
                    height: dp(43)
                    -color: 1, 1, 1, 1
                UiParagraph:
                    text: "Crea tu cuenta y empieza a organizar tus recorridos favoritos."
                    font_size: "11sp"
                    -color: .85, .90, .99, 1

            AnchorLayout:
                size_hint_y: None
                height: registro_form.height + dp(38)
                UiSurface:
                    id: registro_form
                    orientation: "vertical"
                    size_hint: None, None
                    width: min(dp(430), self.parent.width - dp(24))
                    height: self.minimum_height
                    corners: [dp(20)]
                    -bg: app.ui.fondo
                    -stroke: app.ui.borde
                    padding: dp(20), dp(20)
                    spacing: dp(9)

                    UiSection:
                        text: "Crea tu cuenta"
                        font_size: "21sp"
                        height: dp(33)
                    UiParagraph:
                        text: "Regístrate para guardar tus rutas y preferencias."
                        font_size: "12sp"

                    UiText:
                        text: "CORREO ELECTRÓNICO"
                        bold: True
                        font_size: "10sp"
                        -color: app.ui.secundario
                        size_hint_y: None
                        height: dp(21)
                    UiField:
                        id: usuario
                        on_text_validate: clave.focus = True
                        MDTextFieldLeadingIcon:
                            icon: "account-outline"
                        MDTextFieldHintText:
                            text: "correo@ejemplo.com"
                    UiError:
                        id: err_usuario
                        text: ""

                    UiText:
                        text: "CONTRASEÑA"
                        bold: True
                        font_size: "10sp"
                        -color: app.ui.secundario
                        size_hint_y: None
                        height: dp(21)
                    UiField:
                        id: clave
                        password: True
                        on_text_validate: repetir.focus = True
                        MDTextFieldLeadingIcon:
                            icon: "lock-outline"
                        MDTextFieldHintText:
                            text: "Crea una contraseña"
                    UiParagraph:
                        text: "Mínimo 6 caracteres, con una letra y un número."
                        font_size: "10sp"
                    UiError:
                        id: err_clave
                        text: ""

                    UiText:
                        text: "CONFIRMAR CONTRASEÑA"
                        bold: True
                        font_size: "10sp"
                        -color: app.ui.secundario
                        size_hint_y: None
                        height: dp(21)
                    UiField:
                        id: repetir
                        password: True
                        on_text_validate: app.hacer_registro()
                        MDTextFieldLeadingIcon:
                            icon: "lock-check-outline"
                        MDTextFieldHintText:
                            text: "Repetir contraseña"
                    UiError:
                        id: err_repetir
                        text: ""
                    UiError:
                        id: err_general
                        text: ""

                    UiButton:
                        id: registrar_btn
                        text: "Crear mi cuenta"
                        icon: "account-plus-outline"
                        on_release: app.hacer_registro()
                    UiText:
                        text: "¿Ya tienes una cuenta?"
                        font_size: "11sp"
                        halign: "center"
                        -color: app.ui.secundario
                        size_hint_y: None
                        height: dp(24)
                    UiButton:
                        primary: False
                        text: "Volver a iniciar sesión"
                        icon: "login"
                        on_release: app.cambiar_pantalla("login")
                    UiNotice:
                        text: "La cuenta se verifica en nuestro servidor y se puede usar en otro dispositivo."
                        icon: "shield-check-outline"

