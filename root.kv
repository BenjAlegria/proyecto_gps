#:import dp kivy.metrics.dp

# Azul principal y su variante oscura para el tema oscuro
#:set AZUL_CLARO (0.16, 0.45, 0.87, 1)
#:set AZUL_OSCURO (0.05, 0.09, 0.20, 1)

BoxLayout:
    orientation: "vertical"
    canvas.before:
        Color:
            rgba: app.ui.fondo
        Rectangle:
            pos: self.pos
            size: self.size

    ScreenManager:
        id: sm

        CargaScreen:
            name: "carga"

        LoginScreen:
            name: "login"

        RegistroScreen:
            name: "registro"

        HomeScreen:
            name: "home"

        RecorridosScreen:
            name: "recorridos"

        DetalleScreen:
            name: "detalle"

        CompartirScreen:
            name: "compartir"

        AvisosScreen:
            name: "avisos"

        AjustesScreen:
            name: "ajustes"

        PerfilScreen:
            name: "perfil"

    # ----------------------------------------------------------
    # Barra de navegación inferior (oculta en carga, login y registro)
    # ----------------------------------------------------------
    MDBoxLayout:
        id: nav_bar
        size_hint_y: None
        theme_bg_color: "Custom"
        height: 0 if sm.current in ("carga", "login", "registro") else dp(64) + app.safe_bottom
        opacity: 0 if sm.current in ("carga", "login", "registro") else 1
        disabled: sm.current in ("carga", "login", "registro")
        padding: dp(4), dp(4), dp(4), dp(4) + app.safe_bottom
        spacing: dp(4)
        -md_bg_color: app.ui.fondo
        canvas.after:
            Color:
                rgba: app.ui.borde
            Line:
                points: self.x, self.top, self.right, self.top
                width: .7

        NavItem:
            icono_activo: "home"
            icono_inactivo: "home-outline"
            etiqueta: "Inicio"
            activo: sm.current == "home"
            on_release: app.cambiar_pantalla("home")

        NavItem:
            icono_activo: "bus"
            icono_inactivo: "bus-side"
            etiqueta: "Recorridos"
            activo: sm.current in ("recorridos", "detalle")
            on_release: app.cambiar_pantalla("recorridos")

        NavItem:
            icono_activo: "map-marker-radius"
            icono_inactivo: "map-marker-radius-outline"
            etiqueta: "Compartir"
            activo: sm.current == "compartir"
            on_release: app.cambiar_pantalla("compartir")

        NavItem:
            icono_activo: "bell"
            icono_inactivo: "bell-outline"
            etiqueta: "Avisos"
            activo: sm.current == "avisos"
            on_release: app.cambiar_pantalla("avisos")

        NavItem:
            icono_activo: "cog"
            icono_inactivo: "cog-outline"
            etiqueta: "Ajustes"
            activo: sm.current == "ajustes"
            on_release: app.cambiar_pantalla("ajustes")


<NavItem@ButtonBehavior+BoxLayout>:
    icono_activo: ""
    icono_inactivo: ""
    etiqueta: ""
    activo: False
    orientation: "vertical"
    padding: 0, dp(4)

    AnchorLayout:
        anchor_x: "center"
        anchor_y: "center"
        size_hint_y: None
        height: dp(30)

        BoxLayout:
            size_hint: None, None
            size: dp(52), dp(28)

            canvas.before:
                Color:
                    rgba: app.ui.suave if root.activo else (0, 0, 0, 0)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(14)]

            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"

                MDIcon:
                    icon: root.icono_activo if root.activo else root.icono_inactivo
                    icon_color: app.ui.azul if root.activo else app.ui.secundario
                    adaptive_size: True

    AnchorLayout:
        anchor_x: "center"
        anchor_y: "center"
        size_hint_y: None
        height: dp(16)

        MDLabel:
            text: root.etiqueta
            halign: "center"
            font_style: "Label"
            role: "small"
            theme_text_color: "Custom"
            text_color: app.ui.azul if root.activo else app.ui.secundario
            adaptive_size: True


# ----------------------------------------------------------
# Barra superior azul reutilizable (avatar + contenido)
# ----------------------------------------------------------
<TopBar@MDBoxLayout>:
    size_hint_y: None
    height: dp(72)
    padding: dp(12), dp(6), dp(16), dp(6)
    spacing: dp(9)
    theme_bg_color: "Custom"
    -md_bg_color: app.ui.fondo
    canvas.after:
        Color:
            rgba: app.ui.borde
        Line:
            points: self.x, self.y, self.right, self.y
            width: .7

    MDIconButton:
        icon: "account-circle"
        icon_color: app.ui.azul
        pos_hint: {"center_y": 0.5}
        on_release: app.cambiar_pantalla("perfil")
        canvas.before:
            Color:
                rgba: app.ui.suave
            Ellipse:
                pos: self.pos
                size: self.size


<PanelHeader@ButtonBehavior+BoxLayout>:
    orientation: "horizontal"


<LocalidadChip@ButtonBehavior+BoxLayout>:
    orientation: "horizontal"
    padding: dp(14), 0
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: app.ui.suave
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(20)]
        Color:
            rgba: app.ui.borde
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(20))
            width: .7


# ----------------------------------------------------------
# Inicio: mapa con la línea A -> B + panel de buses
# ----------------------------------------------------------
<HomeScreen>:
    on_size: app.ajustar_panel_home()

    FloatLayout:

        MapView:
            id: mapa
            lat: -38.7359
            lon: -72.5904
            zoom: 10
            size_hint: 1, 1
            pos_hint: {"x": 0, "y": 0}

        TopBar:
            id: home_header
            pos_hint: {"top": 1}

            LocalidadChip:
                id: origen_btn
                on_release: app.abrir_menu_origen(self)

                MDIcon:
                    icon: "map-marker"
                    theme_text_color: "Custom"
                    text_color: (1, 1, 1, 1) if app.theme_cls.theme_style == "Dark" else AZUL_CLARO
                    pos_hint: {"center_y": 0.5}

                MDLabel:
                    id: origen_text
                    text: "Elegir localidad"
                    theme_text_color: "Custom"
                    text_color: (0.95, 0.96, 0.98, 1) if app.theme_cls.theme_style == "Dark" else (0.10, 0.12, 0.15, 1)
                    bold: True

                MDIcon:
                    icon: "menu-down"
                    theme_text_color: "Custom"
                    text_color: (1, 1, 1, 1) if app.theme_cls.theme_style == "Dark" else AZUL_CLARO
                    pos_hint: {"center_y": 0.5}

            MDIconButton:
                icon: "share-variant"
                icon_color: 1, 1, 1, 1
                pos_hint: {"center_y": 0.5}
                on_release: app.cambiar_pantalla("compartir")
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 0.18
                    Ellipse:
                        pos: self.pos
                        size: self.size

        MDBoxLayout:
            id: home_selectors
            size_hint: 0.92, None
            height: dp(44)
            spacing: dp(8)
            pos_hint: {"center_x": 0.5}
            y: self.parent.height - home_header.height - self.height - dp(6)

            LocalidadChip:
                id: recorrido_btn
                size_hint_x: 0.58
                on_release: app.abrir_recorrido_home(self)

                MDIcon:
                    icon: "map-marker-path"
                    theme_text_color: "Custom"
                    text_color: (1, 1, 1, 1) if app.theme_cls.theme_style == "Dark" else AZUL_CLARO
                    pos_hint: {"center_y": 0.5}

                MDLabel:
                    id: recorrido_text
                    text: "Todos los destinos"
                    shorten: True
                    shorten_from: "right"
                    theme_text_color: "Custom"
                    text_color: (0.95, 0.96, 0.98, 1) if app.theme_cls.theme_style == "Dark" else (0.10, 0.12, 0.15, 1)

                MDIcon:
                    icon: "menu-down"
                    theme_text_color: "Custom"
                    text_color: (1, 1, 1, 1) if app.theme_cls.theme_style == "Dark" else AZUL_CLARO
                    pos_hint: {"center_y": 0.5}

            MDLabel:
                id: ubicacion_estado
                text: "Tu ubicación: sin consultar"
                font_style: "Body"
                role: "small"
                shorten: True
                shorten_from: "right"
                halign: "right"
                valign: "center"

        MDBoxLayout:
            id: barra_offline
            size_hint: 0.92, None
            height: 0 if app.en_linea else dp(26)
            opacity: 0 if app.en_linea else 1
            padding: dp(10), 0
            pos_hint: {"center_x": 0.5}
            y: self.parent.height - home_header.height - home_selectors.height - dp(10) - self.height
            canvas.before:
                Color:
                    rgba: 0.96, 0.62, 0.07, 0.96
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10)]

            MDLabel:
                text: app.texto_conexion
                font_style: "Body"
                role: "small"
                shorten: True
                shorten_from: "right"
                valign: "center"
                theme_text_color: "Custom"
                text_color: 0.10, 0.10, 0.10, 1

        MDBoxLayout:
            id: banner
            size_hint: 0.92, None
            height: dp(38)
            padding: dp(12), 0
            spacing: dp(8)
            opacity: 0
            pos_hint: {"center_x": 0.5}
            y: self.parent.height - home_header.height - home_selectors.height - barra_offline.height - dp(14) - self.height
            canvas.before:
                Color:
                    rgba: app.ui.tarjeta
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(12)]

            MDIcon:
                icon: "cloud-check-outline"
                adaptive_size: True
                pos_hint: {"center_y": 0.5}
                theme_text_color: "Custom"
                text_color: AZUL_CLARO

            MDLabel:
                id: banner_texto
                text: ""
                shorten: True
                shorten_from: "right"
                font_style: "Body"
                role: "small"
                valign: "center"

        MDIconButton:
            style: "filled"
            icon: "crosshairs-gps"
            pos_hint: {"right": 0.96, "top": 0.64}
            on_release: app.localizarme()

        MDBoxLayout:
            id: panel_buses
            orientation: "vertical"
            size_hint: 1, None
            height: dp(48)
            pos_hint: {"x": 0, "y": 0}
            padding: dp(4), 0
            spacing: dp(2)

            canvas.before:
                Color:
                    rgba: app.ui.tarjeta
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(21), dp(21), 0, 0]

            PanelHeader:
                size_hint_y: None
                height: dp(46)
                padding: dp(12), 0
                on_release: app.alternar_panel_buses()

                MDLabel:
                    id: lineas_titulo
                    text: "Buses de la localidad"
                    bold: True

                MDIcon:
                    id: panel_icono
                    icon: "chevron-up"
                    adaptive_size: True
                    pos_hint: {"center_y": 0.5}

            ScrollView:
                size_hint_y: 1
                MDBoxLayout:
                    id: lineas_box
                    orientation: "vertical"
                    spacing: dp(6)
                    padding: dp(8), 0, dp(8), dp(8)
                    adaptive_height: True


# ----------------------------------------------------------
# Tarjetas
# ----------------------------------------------------------
<LineaCard>:
    style: "elevated"
    orientation: "horizontal"
    size_hint_y: None
    height: dp(84)
    padding: dp(12), dp(8)
    spacing: dp(10)
    radius: [dp(18)]
    on_release: app.mostrar_detalle(root.rid)

    MDIcon:
        icon: "bus"
        theme_text_color: "Custom"
        text_color: (1, 1, 1, 0.9) if app.theme_cls.theme_style == "Dark" else (0.10, 0.12, 0.15, 1)
        size_hint_x: None
        width: dp(32)
        pos_hint: {"center_y": 0.5}

    BoxLayout:
        orientation: "vertical"

        MDLabel:
            text: root.ruta
            bold: True
            font_style: "Body"
            role: "medium"

        MDLabel:
            text: root.detalle
            font_style: "Body"
            role: "small"

        MDLabel:
            text: root.aviso
            bold: True
            font_style: "Body"
            role: "small"
            theme_text_color: "Custom"
            text_color: root.aviso_color

    BoxLayout:
        orientation: "vertical"
        size_hint_x: None
        width: dp(70)

        MDLabel:
            text: root.minutos
            halign: "right"
            bold: True
            theme_text_color: "Custom"
            text_color: 0.05, 0.62, 0.43, 1

        MDLabel:
            text: "duración"
            halign: "right"
            font_style: "Body"
            role: "small"


<AvisoCard>:
    style: "outlined"
    orientation: "horizontal"
    size_hint_y: None
    height: dp(112)
    padding: dp(12), dp(8)
    spacing: dp(10)
    radius: [dp(18)]

    MDIcon:
        icon: root.icono
        theme_text_color: "Custom"
        text_color: root.color
        size_hint_x: None
        width: dp(32)
        pos_hint: {"center_y": 0.5}

    BoxLayout:
        orientation: "vertical"

        MDLabel:
            text: root.titulo
            bold: True
            font_style: "Body"
            role: "medium"
            theme_text_color: "Custom"
            text_color: root.color

        MDLabel:
            text: root.detalle
            font_style: "Body"
            role: "small"

        MDLabel:
            text: (root.autor + " · " + root.nivel) if root.autor else ""
            font_style: "Body"
            role: "small"
            theme_text_color: "Secondary"

        BoxLayout:
            size_hint_y: None
            height: dp(32)
            spacing: dp(2)

            MDLabel:
                text: "¿Es correcto?"
                font_style: "Body"
                role: "small"
                size_hint_x: None
                width: dp(90)

            MDIconButton:
                icon: "thumb-up" if root.mi_voto == 1 else "thumb-up-outline"
                style: "standard"
                size_hint: None, None
                size: dp(32), dp(32)
                disabled: root.propio
                on_release: app.votar_aviso(root.aviso_id, 1)

            MDLabel:
                text: str(root.votos_ok)
                size_hint_x: None
                width: dp(28)

            MDIconButton:
                icon: "thumb-down" if root.mi_voto == -1 else "thumb-down-outline"
                style: "standard"
                size_hint: None, None
                size: dp(32), dp(32)
                disabled: root.propio
                on_release: app.votar_aviso(root.aviso_id, -1)

            MDLabel:
                text: str(root.votos_mal)


<DatoRuta@MDCard>:
    icono: ""
    titulo: ""
    valor: ""
    style: "outlined"
    orientation: "vertical"
    size_hint_y: None
    height: dp(88)
    padding: dp(8)
    radius: [dp(18)]

    MDIcon:
        icon: root.icono
        halign: "center"
        size_hint_y: None
        height: dp(28)

    MDLabel:
        text: root.valor
        halign: "center"
        bold: True
        font_style: "Body"
        role: "small"

    MDLabel:
        text: root.titulo
        halign: "center"
        font_style: "Body"
        role: "small"
        theme_text_color: "Secondary"


# ----------------------------------------------------------
# Detalle de un recorrido
# ----------------------------------------------------------
<DetalleScreen>:
    BoxLayout:
        orientation: "vertical"

        MDBoxLayout:
            size_hint_y: None
            height: dp(58)
            padding: dp(6), 0
            spacing: dp(6)
            md_bg_color: app.ui.marino

            MDIconButton:
                icon: "arrow-left"
                icon_color: 1, 1, 1, 1
                pos_hint: {"center_y": 0.5}
                on_release: app.cerrar_detalle()

            MDLabel:
                text: "Detalle del recorrido"
                bold: True
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                pos_hint: {"center_y": 0.5}

        # Mapa con la línea punto A -> punto B (fuera del scroll para poder moverlo)
        MapView:
            id: mapa_detalle
            lat: -38.7359
            lon: -72.5904
            zoom: 10
            size_hint_y: None
            height: dp(200)

        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(12)
                padding: dp(12)
                adaptive_height: True

                # --- Cabecera: nombre, A -> B y estado de verificación ---
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(104)
                    padding: dp(16)
                    spacing: dp(10)
                    radius: [18]
                    md_bg_color: app.ui.marino

                    MDIcon:
                        icon: "bus"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        size_hint_x: None
                        width: dp(40)
                        pos_hint: {"center_y": 0.5}

                    BoxLayout:
                        orientation: "vertical"

                        MDLabel:
                            id: det_titulo
                            text: ""
                            bold: True
                            font_style: "Title"
                            role: "medium"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                        MDLabel:
                            id: det_ruta_texto
                            text: ""
                            font_style: "Body"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 0.9

                        MDLabel:
                            id: det_parada
                            text: ""
                            font_style: "Body"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 0.75

                    MDLabel:
                        id: det_ver
                        text: ""
                        halign: "right"
                        bold: True
                        size_hint_x: None
                        width: dp(96)
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 0.85

                # --- Frecuencia, duración y tarifa ---
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(88)
                    spacing: dp(8)

                    DatoRuta:
                        id: det_frecuencia
                        icono: "timer-sand"
                        titulo: "Frecuencia"

                    DatoRuta:
                        id: det_duracion
                        icono: "clock-outline"
                        titulo: "Duración"

                    DatoRuta:
                        id: det_tarifa
                        icono: "cash"
                        titulo: "Tarifa"

                # --- ¿Este recorrido es real? (votación) ---
                MDCard:
                    theme_bg_color: "Custom"
                    -md_bg_color: app.ui.tarjeta
                    style: "outlined"
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(124)
                    padding: dp(14), dp(8)
                    radius: [dp(18)]

                    MDLabel:
                        text: "¿Este recorrido es real?"
                        bold: True
                        size_hint_y: None
                        height: dp(28)

                    BoxLayout:
                        size_hint_y: None
                        height: dp(44)
                        spacing: dp(6)

                        MDIconButton:
                            id: det_like
                            icon: "thumb-up-outline"
                            style: "tonal"
                            pos_hint: {"center_y": 0.5}
                            on_release: app.votar_recorrido(1)

                        MDLabel:
                            id: det_n_ok
                            text: "0"
                            size_hint_x: None
                            width: dp(36)
                            bold: True

                        MDIconButton:
                            id: det_dislike
                            icon: "thumb-down-outline"
                            style: "tonal"
                            pos_hint: {"center_y": 0.5}
                            on_release: app.votar_recorrido(-1)

                        MDLabel:
                            id: det_n_mal
                            text: "0"
                            bold: True

                    MDLabel:
                        id: det_confianza
                        text: ""
                        font_style: "Body"
                        role: "small"

                # --- Estado actual según los avisos ---
                MDCard:
                    theme_bg_color: "Custom"
                    -md_bg_color: app.ui.tarjeta
                    style: "outlined"
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(60)
                    padding: dp(14), dp(8)
                    spacing: dp(10)
                    radius: [dp(18)]

                    MDIcon:
                        icon: "information-outline"
                        size_hint_x: None
                        width: dp(28)
                        pos_hint: {"center_y": 0.5}

                    BoxLayout:
                        orientation: "vertical"

                        MDLabel:
                            text: "Estado ahora"
                            font_style: "Body"
                            role: "small"

                        MDLabel:
                            id: det_estado
                            text: ""
                            bold: True
                            font_style: "Body"
                            role: "medium"
                            theme_text_color: "Custom"
                            text_color: 0.5, 0.52, 0.58, 1

                MDButton:
                    style: "tonal"
                    size_hint_y: None
                    height: dp(44)
                    pos_hint: {"center_x": 0.5}
                    on_release: app.alternar_favorita(app.id_detalle)

                    MDButtonIcon:
                        id: det_fav_icono
                        icon: "star-outline"

                    MDButtonText:
                        id: det_fav_texto
                        text: "Agregar a favoritas"

                # --- Avisos de este recorrido, con votos ---
                MDLabel:
                    text: "Avisos recientes de este recorrido"
                    bold: True
                    font_style: "Title"
                    role: "small"
                    size_hint_y: None
                    height: dp(28)

                MDLabel:
                    text: "Vota si cada aviso es correcto: así sube la confianza de quienes informan bien."
                    font_style: "Body"
                    role: "small"
                    size_hint_y: None
                    height: dp(36)

                MDLabel:
                    id: det_vacio
                    text: "Aún no hay avisos para este recorrido."
                    font_style: "Body"
                    role: "small"
                    size_hint_y: None
                    height: dp(40)

                MDBoxLayout:
                    id: det_avisos_box
                    orientation: "vertical"
                    spacing: dp(8)
                    adaptive_height: True


# ----------------------------------------------------------
# Recorridos
# ----------------------------------------------------------
<RecorridosScreen>:
    BoxLayout:
        orientation: "vertical"

        TopBar:
            MDLabel:
                text: "Recorridos"
                bold: True
                theme_text_color: "Custom"
                text_color: app.ui.texto
                pos_hint: {"center_y": 0.5}

        BoxLayout:
            orientation: "vertical"
            padding: dp(12), dp(8), dp(12), dp(4)
            spacing: dp(8)

            UiJourneyHero:
                etiqueta: "02 / RECORRIDOS"
                titulo: "Encuentra tu próximo viaje"
                descripcion: "Consulta líneas, destinos y opiniones de la comunidad."
                icono: "bus-clock"

            MDLabel:
                id: recorridos_resumen
                text: ""
                font_style: "Body"
                role: "medium"
                size_hint_y: None
                height: dp(24)

            ScrollView:
                MDBoxLayout:
                    id: recorridos_box
                    orientation: "vertical"
                    spacing: dp(8)
                    padding: 0, 0, 0, dp(8)
                    adaptive_height: True


# ----------------------------------------------------------
# Compartir: exige patente o viaje agendado
# ----------------------------------------------------------
<CompartirScreen>:
    BoxLayout:
        orientation: "vertical"

        TopBar:
            MDLabel:
                text: "Compartir ubicación"
                bold: True
                theme_text_color: "Custom"
                text_color: app.ui.texto
                pos_hint: {"center_y": 0.5}

        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                padding: dp(12), dp(8), dp(12), dp(12)
                spacing: dp(10)
                adaptive_height: True

                UiJourneyHero:
                    etiqueta: "03 / COMPARTIR"
                    titulo: "Ayuda a otros pasajeros"
                    descripcion: "Comparte reportes y la información de tu viaje con control."
                    icono: "map-marker-check-outline"

                MDLabel:
                    text: "¿Vas en la micro? Elige tu línea e identifica el bus con su patente o agenda el viaje. Solo cuentas registradas."
                    size_hint_y: None
                    height: dp(72)

                MDButton:
                    id: linea_btn
                    style: "outlined"
                    size_hint_y: None
                    height: dp(40)
                    on_release: app.abrir_menu_linea(self)

                    MDButtonIcon:
                        icon: "bus"

                    MDButtonText:
                        id: linea_text
                        text: "Elegir mi línea"

                    MDButtonIcon:
                        icon: "menu-down"

                MDLabel:
                    id: linea_error
                    text: ""
                    theme_text_color: "Error"
                    size_hint_y: None
                    height: dp(20)

                MDTextField:
                    id: patente_field
                    mode: "outlined"
                    size_hint_y: None
                    height: dp(64)
                    multiline: False
                    write_tab: False

                    MDTextFieldLeadingIcon:
                        icon: "card-text-outline"

                    MDTextFieldHintText:
                        text: "Patente del bus (ej.: AB1234 o BCDF12)"

                MDTextField:
                    id: agenda_field
                    mode: "outlined"
                    size_hint_y: None
                    height: dp(64)
                    multiline: False
                    write_tab: False

                    MDTextFieldLeadingIcon:
                        icon: "calendar-clock-outline"

                    MDTextFieldHintText:
                        text: "Agendar viaje: DD/MM HH:MM (opcional)"

                MDLabel:
                    id: patente_error
                    text: ""
                    theme_text_color: "Error"
                    font_style: "Body"
                    role: "small"
                    size_hint_y: None
                    height: dp(36)

                MDButton:
                    id: compartir_btn
                    style: "filled"
                    size_hint_y: None
                    height: dp(44)
                    pos_hint: {"center_x": 0.5}
                    on_release: app.alternar_compartir()

                    MDButtonText:
                        id: compartir_btn_text
                        text: "INICIAR VIAJE"

                MDLabel:
                    id: estado_label
                    text: "Tu ubicación no se está compartiendo."
                    halign: "center"
                    font_style: "Body"
                    role: "small"
                    size_hint_y: None
                    height: dp(24)

                MDLabel:
                    text: "Avisar a otros pasajeros"
                    bold: True
                    size_hint_y: None
                    height: dp(28)

                MDLabel:
                    text: "Usa la línea elegida arriba. Otros pasajeros podrán votar si tu aviso es correcto y así ganas puntos."
                    font_style: "Body"
                    role: "small"
                    size_hint_y: None
                    height: dp(48)

                GridLayout:
                    cols: 2
                    spacing: dp(8)
                    size_hint_y: None
                    height: dp(96)
                    row_default_height: dp(44)
                    row_force_default: True

                    MDButton:
                        style: "tonal"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: app.enviar_aviso("lleno")

                        MDButtonIcon:
                            icon: "account-group"

                        MDButtonText:
                            text: "Bus lleno"

                    MDButton:
                        style: "tonal"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: app.enviar_aviso("asientos")

                        MDButtonIcon:
                            icon: "seat-passenger"

                        MDButtonText:
                            text: "Hay asientos"

                    MDButton:
                        style: "tonal"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: app.abrir_menu_atraso(self)

                        MDButtonIcon:
                            icon: "clock-alert"

                        MDButtonText:
                            text: "Atrasado"

                    MDButton:
                        style: "tonal"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: app.enviar_aviso("cambio_ruta")

                        MDButtonIcon:
                            icon: "map-marker-alert"

                        MDButtonText:
                            text: "Cambio de ruta"


# ----------------------------------------------------------
# Avisos
# ----------------------------------------------------------
<AvisosScreen>:
    BoxLayout:
        orientation: "vertical"

        TopBar:
            MDLabel:
                text: "Avisos"
                bold: True
                theme_text_color: "Custom"
                text_color: app.ui.texto
                pos_hint: {"center_y": 0.5}

        BoxLayout:
            orientation: "vertical"
            padding: dp(12), dp(8), dp(12), dp(4)
            spacing: dp(8)

            UiJourneyHero:
                etiqueta: "04 / COMUNIDAD"
                titulo: "Viaja mejor informado"
                descripcion: "Revisa reportes recientes y valora su utilidad."
                icono: "bell-outline"

            MDCard:
                theme_bg_color: "Custom"
                -md_bg_color: app.ui.tarjeta
                style: "outlined"
                orientation: "horizontal"
                size_hint_y: None
                height: dp(56)
                padding: dp(12), dp(6)
                radius: [dp(18)]

                MDLabel:
                    text: "Solo mis rutas favoritas"
                    font_style: "Body"
                    role: "medium"

                MDSwitch:
                    pos_hint: {"center_y": 0.5}
                    on_active: app.alternar_solo_favoritas(self.active)

            MDLabel:
                id: avisos_vacio
                text: ""
                font_style: "Body"
                role: "small"
                size_hint_y: None
                height: dp(40)

            ScrollView:
                MDBoxLayout:
                    id: avisos_box
                    orientation: "vertical"
                    spacing: dp(8)
                    padding: 0, 0, 0, dp(8)
                    adaptive_height: True


# ----------------------------------------------------------
# Ajustes
# ----------------------------------------------------------
<AjustesScreen>:
    BoxLayout:
        orientation: "vertical"

        TopBar:
            MDLabel:
                text: "Ajustes"
                bold: True
                theme_text_color: "Custom"
                text_color: app.ui.texto
                pos_hint: {"center_y": 0.5}

        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                padding: dp(12), dp(10)
                spacing: dp(10)
                adaptive_height: True

                UiJourneyHero:
                    etiqueta: "05 / PREFERENCIAS"
                    titulo: "Viaja a tu manera"
                    descripcion: "Controla apariencia, privacidad y conexión con el servidor."
                    icono: "tune-variant"

                MDCard:
                    theme_bg_color: "Custom"
                    -md_bg_color: app.ui.tarjeta
                    style: "outlined"
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(64)
                    padding: dp(12), dp(8)
                    radius: [dp(18)]

                    MDLabel:
                        text: "Tema oscuro"
                        font_style: "Body"
                        role: "medium"

                    MDSwitch:
                        id: switch_tema
                        pos_hint: {"center_y": 0.5}
                        on_active: app.cambiar_tema(self.active)

                MDCard:
                    theme_bg_color: "Custom"
                    -md_bg_color: app.ui.tarjeta
                    style: "outlined"
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(72)
                    padding: dp(12), dp(8)
                    radius: [dp(18)]

                    MDLabel:
                        text: "Avisarme de atrasos y buses llenos en mis rutas favoritas"
                        font_style: "Body"
                        role: "medium"

                    MDSwitch:
                        id: switch_notif
                        active: True
                        pos_hint: {"center_y": 0.5}
                        on_active: app.cambiar_notificaciones(self.active)

                MDCard:
                    theme_bg_color: "Custom"
                    -md_bg_color: app.ui.tarjeta
                    style: "outlined"
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(96)
                    padding: dp(12), dp(8)
                    radius: [dp(18)]

                    BoxLayout:
                        MDLabel:
                            text: "Ayudar con métricas anónimas"
                            font_style: "Body"
                            role: "medium"

                        MDSwitch:
                            id: switch_metricas
                            pos_hint: {"center_y": 0.5}
                            on_active: app.cambiar_analitica(self.active)

                    MDLabel:
                        id: mjv_estado
                        text: "Métricas anónimas desactivadas"
                        font_style: "Body"
                        role: "small"

                MDCard:
                    theme_bg_color: "Custom"
                    -md_bg_color: app.ui.tarjeta
                    style: "outlined"
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(150)
                    padding: dp(12), dp(8)
                    spacing: dp(4)
                    radius: [dp(18)]

                    MDLabel:
                        text: "Conexión con el servidor"
                        bold: True
                        font_style: "Body"
                        role: "medium"
                        size_hint_y: None
                        height: dp(24)

                    MDLabel:
                        id: conexion_estado
                        text: ""
                        font_style: "Body"
                        role: "small"

                    MDButton:
                        style: "text"
                        size_hint_y: None
                        height: dp(36)
                        on_release: app.sincronizar(manual=True, completo=True)

                        MDButtonIcon:
                            icon: "sync"

                        MDButtonText:
                            text: "Sincronizar ahora"

                MDCard:
                    theme_bg_color: "Custom"
                    -md_bg_color: app.ui.tarjeta
                    style: "outlined"
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(150)
                    padding: dp(12), dp(8)
                    spacing: dp(4)
                    radius: [dp(18)]

                    MDLabel:
                        text: "Configuración remota"
                        bold: True
                        font_style: "Body"
                        role: "medium"
                        size_hint_y: None
                        height: dp(24)

                    MDLabel:
                        id: cfg_estado
                        text: ""
                        font_style: "Body"
                        role: "small"

                    MDButton:
                        style: "text"
                        size_hint_y: None
                        height: dp(36)
                        on_release: app.actualizar_config_remota()

                        MDButtonIcon:
                            icon: "cloud-refresh-outline"

                        MDButtonText:
                            text: "Actualizar"

                MDButton:
                    style: "outlined"
                    size_hint_y: None
                    height: dp(40)
                    pos_hint: {"center_x": 0.5}
                    on_release: app.cerrar_sesion()

                    MDButtonIcon:
                        icon: "logout"

                    MDButtonText:
                        id: cerrar_texto
                        text: "Cerrar sesión"

                MDLabel:
                    text: "EnRuta Ya! v3.0"
                    halign: "center"
                    font_style: "Body"
                    role: "small"
                    size_hint_y: None
                    height: dp(20)


# ----------------------------------------------------------
# Perfil (nivel y puntos; el invitado ve solo el resumen)
# ----------------------------------------------------------
<PerfilScreen>:
    BoxLayout:
        orientation: "vertical"

        TopBar:
            MDLabel:
                text: "Mi perfil"
                bold: True
                theme_text_color: "Custom"
                text_color: app.ui.texto
                pos_hint: {"center_y": 0.5}

        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(10)
                padding: dp(12), dp(10), dp(12), dp(8)
                adaptive_height: True

                UiJourneyHero:
                    etiqueta: "TU CUENTA"
                    titulo: "Tu espacio en EnRuta"
                    descripcion: "Tus recorridos, aportes y preferencias personales."
                    icono: "account-circle-outline"

                MDCard:
                    theme_bg_color: "Custom"
                    -md_bg_color: app.ui.tarjeta
                    style: "filled"
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(88)
                    padding: dp(14)
                    spacing: dp(14)
                    radius: [dp(18)]

                    MDIcon:
                        icon: "account-circle"
                        font_size: "56sp"
                        size_hint_x: None
                        width: dp(64)
                        pos_hint: {"center_y": 0.5}

                    BoxLayout:
                        orientation: "vertical"

                        MDLabel:
                            id: nombre_label
                            text: "Usuario"
                            bold: True
                            font_style: "Title"
                            role: "medium"

                        MDLabel:
                            id: usuario_label
                            text: ""
                            font_style: "Body"
                            role: "small"

                MDCard:
                    theme_bg_color: "Custom"
                    -md_bg_color: app.ui.tarjeta
                    style: "outlined"
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(76)
                    padding: dp(14)
                    spacing: dp(12)
                    radius: [dp(18)]

                    MDIcon:
                        id: nivel_icono
                        icon: "account-outline"
                        size_hint_x: None
                        width: dp(40)
                        pos_hint: {"center_y": 0.5}

                    BoxLayout:
                        orientation: "vertical"

                        MDLabel:
                            id: nivel_label
                            text: "Novato · 0 puntos"
                            bold: True

                        MDLabel:
                            id: nivel_falta
                            text: ""
                            font_style: "Body"
                            role: "small"

                MDBoxLayout:
                    id: perfil_editable
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(112)
                    spacing: dp(8)

                    MDTextField:
                        id: nombre_field
                        mode: "outlined"
                        size_hint_y: None
                        height: dp(64)
                        on_text_validate: app.guardar_nombre(self)

                        MDTextFieldHintText:
                            text: "Cambiar nombre"

                        MDTextFieldHelperText:
                            text: "Escribe un nombre (máx. 30 caracteres)"
                            mode: "on_error"

                    MDButton:
                        style: "tonal"
                        size_hint_y: None
                        height: dp(40)
                        pos_hint: {"center_x": 0.5}
                        on_release: app.guardar_nombre(nombre_field)

                        MDButtonText:
                            text: "GUARDAR NOMBRE"

                MDBoxLayout:
                    size_hint_y: None
                    height: dp(84)
                    spacing: dp(10)

                    MDCard:
                        theme_bg_color: "Custom"
                        -md_bg_color: app.ui.tarjeta
                        style: "elevated"
                        orientation: "vertical"
                        padding: dp(8)
                        radius: [dp(18)]

                        MDLabel:
                            id: viajes_num
                            text: "0"
                            halign: "center"
                            bold: True
                            font_style: "Headline"
                            role: "small"

                        MDLabel:
                            text: "Viajes compartidos"
                            halign: "center"
                            font_style: "Body"
                            role: "small"

                    MDCard:
                        theme_bg_color: "Custom"
                        -md_bg_color: app.ui.tarjeta
                        style: "elevated"
                        orientation: "vertical"
                        padding: dp(8)
                        radius: [dp(18)]

                        MDLabel:
                            id: fav_num
                            text: "0"
                            halign: "center"
                            bold: True
                            font_style: "Headline"
                            role: "small"

                        MDLabel:
                            text: "Rutas favoritas"
                            halign: "center"
                            font_style: "Body"
                            role: "small"

                MDCard:
                    theme_bg_color: "Custom"
                    -md_bg_color: app.ui.tarjeta
                    style: "outlined"
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(64)
                    padding: dp(12), dp(8)
                    radius: [dp(18)]

                    MDLabel:
                        text: "Permitir compartir mi ubicación durante viajes"
                        font_style: "Body"
                        role: "medium"

                    MDSwitch:
                        id: switch_consent
                        pos_hint: {"center_y": 0.5}
                        on_active: app.cambiar_consentimiento(self.active)

                MDLabel:
                    text: "Mis rutas favoritas"
                    bold: True
                    size_hint_y: None
                    height: dp(28)

                MDLabel:
                    id: fav_vacio
                    text: "Aún no tienes favoritas. Abre un recorrido y agrégalo."
                    font_style: "Body"
                    role: "small"
                    size_hint_y: None
                    height: dp(40)

                MDBoxLayout:
                    id: fav_box
                    orientation: "vertical"
                    spacing: dp(6)
                    adaptive_height: True


# ----------------------------------------------------------
# Carga, login (con invitado) y registro
# ----------------------------------------------------------
<CargaScreen>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: app.ui.marino
            Rectangle:
                pos: self.pos
                size: self.size
        AnchorLayout:
            anchor_x: "center"
            anchor_y: "center"
            BoxLayout:
                orientation: "vertical"
                spacing: dp(13)
                size_hint: None, None
                size: min(dp(340), self.parent.width - dp(35)), dp(245)
                AnchorLayout:
                    size_hint_y: None
                    height: dp(70)
                    UiIcon:
                        icon: "bus-side"
                        font_size: "60sp"
                        -icon_color: 1, 1, 1, 1
                UiText:
                    text: "EnRuta Ya!"
                    bold: True
                    font_size: "30sp"
                    halign: "center"
                    -color: 1, 1, 1, 1
                UiParagraph:
                    text: "Tu viaje comienza aquí"
                    halign: "center"
                    font_size: "13sp"
                    -color: .77, .85, 1, 1
                Widget:
                    size_hint_y: None
                    height: dp(8)
                UiParagraph:
                    id: carga_estado
                    text: "Preparando la aplicación…"
                    halign: "center"
                    font_size: "12sp"
                    -color: .95, .97, 1, 1

<LoginScreen>:
    UiScroll:
        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            # Hero azul marino: marca y propósito antes del formulario.
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: dp(238)
                padding: dp(24), dp(21), dp(24), dp(20)
                spacing: dp(12)
                canvas.before:
                    Color:
                        rgba: app.ui.marino
                    Rectangle:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: .20, .43, .85, .28
                    Ellipse:
                        pos: self.right - dp(170), self.top - dp(165)
                        size: dp(186), dp(186)
                    Color:
                        rgba: .44, .70, 1, .16
                    Ellipse:
                        pos: self.right - dp(113), self.top - dp(218)
                        size: dp(126), dp(126)
                BoxLayout:
                    size_hint_y: None
                    height: dp(44)
                    spacing: dp(11)
                    UiSurface:
                        size_hint: None, None
                        size: dp(44), dp(44)
                        corners: [dp(14)]
                        -bg: .157, .404, .910, 1
                        -stroke: 0, 0, 0, 0
                        padding: 0
                        AnchorLayout:
                            UiIcon:
                                icon: "bus-side"
                                font_size: "27sp"
                                size: dp(30), dp(30)
                                -icon_color: 1, 1, 1, 1
                    BoxLayout:
                        orientation: "vertical"
                        UiText:
                            text: "EnRuta Ya!"
                            font_size: "19sp"
                            bold: True
                            -color: 1, 1, 1, 1
                        UiText:
                            text: "RUTAS DE LA ARAUCANÍA"
                            font_size: "9sp"
                            bold: True
                            -color: .72, .83, 1, 1
                Widget:
                    size_hint_y: None
                    height: dp(2)
                UiText:
                    text: "Tu próximo viaje\ncomienza aquí."
                    shorten: False
                    font_size: "27sp"
                    bold: True
                    size_hint_y: None
                    height: dp(74)
                    -color: 1, 1, 1, 1
                UiParagraph:
                    text: "Encuentra tus recorridos, consulta el mapa y viaja mejor informado."
                    -color: .85, .90, .99, 1
                    font_size: "11sp"

            # Tarjeta de acceso: conserva los IDs utilizados en main.py.
            AnchorLayout:
                size_hint_y: None
                height: login_card.height + dp(38)
                UiSurface:
                    id: login_card
                    orientation: "vertical"
                    size_hint: None, None
                    width: min(dp(430), self.parent.width - dp(24))
                    height: self.minimum_height
                    corners: [dp(20)]
                    -bg: app.ui.fondo
                    -stroke: app.ui.borde
                    padding: dp(20), dp(22)
                    spacing: dp(10)

                    UiSection:
                        text: "¡Qué bueno verte!"
                        font_size: "21sp"
                        height: dp(32)
                    UiParagraph:
                        text: "Ingresa a tu cuenta para continuar tu viaje."
                        font_size: "12sp"

                    UiText:
                        text: "CORREO ELECTRÓNICO"
                        bold: True
                        font_size: "10sp"
                        -color: app.ui.secundario
                        size_hint_y: None
                        height: dp(23)
                    UiField:
                        id: usuario
                        on_text_validate: clave.focus = True
                        MDTextFieldLeadingIcon:
                            icon: "account-outline"
                        MDTextFieldHintText:
                            text: "correo@ejemplo.com"
                    UiError:
                        id: err_usuario
                        text: ""

                    UiText:
                        text: "CONTRASEÑA"
                        bold: True
                        font_size: "10sp"
                        -color: app.ui.secundario
                        size_hint_y: None
                        height: dp(23)
                    UiField:
                        id: clave
                        password: True
                        on_text_validate: app.hacer_login()
                        MDTextFieldLeadingIcon:
                            icon: "lock-outline"
                        MDTextFieldHintText:
                            text: "Tu contraseña"
                    UiError:
                        id: err_general
                        text: ""

                    UiButton:
                        id: ingresar_btn
                        text: "Entrar a EnRuta"
                        icon: "arrow-right"
                        on_release: app.hacer_login()

                    UiButton:
                        primary: False
                        text: "Continuar como invitado"
                        icon: "account-outline"
                        on_release: app.entrar_invitado()

                    UiText:
                        text: "¿Aún no tienes cuenta?"
                        font_size: "11sp"
                        halign: "center"
                        -color: app.ui.secundario
                        size_hint_y: None
                        height: dp(26)
                    UiButton:
                        primary: False
                        text: "Crear cuenta gratis"
                        icon: "account-plus-outline"
                        on_release: app.cambiar_pantalla("registro")

                    UiNotice:
                        text: "Tu ubicación no se comparte. Los avisos se sincronizan automáticamente tras iniciar sesión."
                        icon: "shield-check-outline"

<RegistroScreen>:
    UiScroll:
        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            # Bienvenida compacta, hermana visual del Login.
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: dp(184)
                padding: dp(24), dp(21), dp(24), dp(17)
                spacing: dp(10)
                canvas.before:
                    Color:
                        rgba: app.ui.marino
                    Rectangle:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: .20, .43, .85, .28
                    Ellipse:
                        pos: self.right - dp(160), self.top - dp(155)
                        size: dp(182), dp(182)
                BoxLayout:
                    size_hint_y: None
                    height: dp(42)
                    spacing: dp(11)
                    UiSurface:
                        size_hint: None, None
                        size: dp(42), dp(42)
                        corners: [dp(14)]
                        -bg: .157, .404, .910, 1
                        -stroke: 0, 0, 0, 0
                        padding: 0
                        AnchorLayout:
                            UiIcon:
                                icon: "bus-side"
                                font_size: "25sp"
                                -icon_color: 1, 1, 1, 1
                    UiText:
                        text: "EnRuta Ya!"
                        font_size: "19sp"
                        bold: True
                        -color: 1, 1, 1, 1
                UiText:
                    text: "Únete a la ruta."
                    font_size: "26sp"
                    bold: True
                    size_hint_y: None
                    height: dp(43)
                    -color: 1, 1, 1, 1
                UiParagraph:
                    text: "Crea tu cuenta y empieza a organizar tus recorridos favoritos."
                    font_size: "11sp"
                    -color: .85, .90, .99, 1

            AnchorLayout:
                size_hint_y: None
                height: registro_form.height + dp(38)
                UiSurface:
                    id: registro_form
                    orientation: "vertical"
                    size_hint: None, None
                    width: min(dp(430), self.parent.width - dp(24))
                    height: self.minimum_height
                    corners: [dp(20)]
                    -bg: app.ui.fondo
                    -stroke: app.ui.borde
                    padding: dp(20), dp(20)
                    spacing: dp(9)

                    UiSection:
                        text: "Crea tu cuenta"
                        font_size: "21sp"
                        height: dp(33)
                    UiParagraph:
                        text: "Regístrate para guardar tus rutas y preferencias."
                        font_size: "12sp"

                    UiText:
                        text: "CORREO ELECTRÓNICO"
                        bold: True
                        font_size: "10sp"
                        -color: app.ui.secundario
                        size_hint_y: None
                        height: dp(21)
                    UiField:
                        id: usuario
                        on_text_validate: clave.focus = True
                        MDTextFieldLeadingIcon:
                            icon: "account-outline"
                        MDTextFieldHintText:
                            text: "correo@ejemplo.com"
                    UiError:
                        id: err_usuario
                        text: ""

                    UiText:
                        text: "CONTRASEÑA"
                        bold: True
                        font_size: "10sp"
                        -color: app.ui.secundario
                        size_hint_y: None
                        height: dp(21)
                    UiField:
                        id: clave
                        password: True
                        on_text_validate: repetir.focus = True
                        MDTextFieldLeadingIcon:
                            icon: "lock-outline"
                        MDTextFieldHintText:
                            text: "Crea una contraseña"
                    UiParagraph:
                        text: "Mínimo 6 caracteres, con una letra y un número."
                        font_size: "10sp"
                    UiError:
                        id: err_clave
                        text: ""

                    UiText:
                        text: "CONFIRMAR CONTRASEÑA"
                        bold: True
                        font_size: "10sp"
                        -color: app.ui.secundario
                        size_hint_y: None
                        height: dp(21)
                    UiField:
                        id: repetir
                        password: True
                        on_text_validate: app.hacer_registro()
                        MDTextFieldLeadingIcon:
                            icon: "lock-check-outline"
                        MDTextFieldHintText:
                            text: "Repetir contraseña"
                    UiError:
                        id: err_repetir
                        text: ""
                    UiError:
                        id: err_general
                        text: ""

                    UiButton:
                        id: registrar_btn
                        text: "Crear mi cuenta"
                        icon: "account-plus-outline"
                        on_release: app.hacer_registro()
                    UiText:
                        text: "¿Ya tienes una cuenta?"
                        font_size: "11sp"
                        halign: "center"
                        -color: app.ui.secundario
                        size_hint_y: None
                        height: dp(24)
                    UiButton:
                        primary: False
                        text: "Volver a iniciar sesión"
                        icon: "login"
                        on_release: app.cambiar_pantalla("login")
                    UiNotice:
                        text: "La cuenta se verifica en nuestro servidor y se puede usar en otro dispositivo."
                        icon: "shield-check-outline"

