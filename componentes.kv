#:import dp kivy.metrics.dp
#:import md_icons kivymd.icon_definitions.md_icons

# El prefijo - elimina bindings KV heredados antes de aplicar el nuevo valor.
# Sin él, una regla base puede volver a imponer su color/tamaño al cambiar tema.
# Etiquetas Kivy: el tema MD no sobrescribe su color al cambiar de pantalla.
<UiText@Label>:
    -color: app.ui.texto
    font_name: "Roboto"
    font_size: "13sp"
    text_size: self.size
    halign: "left"
    valign: "middle"
    shorten: True
    shorten_from: "right"

<UiParagraph@UiText>:
    shorten: False
    -text_size: self.width, None
    size_hint_y: None
    -height: self.texture_size[1] + dp(6)
    -color: app.ui.secundario

<UiSection@UiText>:
    bold: True
    font_size: "17sp"
    size_hint_y: None
    height: dp(28)

<UiError@UiParagraph>:
    -color: app.ui.rojo
    font_size: "11sp"
    -height: self.texture_size[1] + dp(6) if self.text else 0

# Fuente Icons de KivyMD, sin heredar las reglas de color de MDLabel/MDIcon.
<UiIcon@Label>:
    icon: "bus-side"
    -icon_color: app.ui.azul
    -color: self.icon_color or app.ui.azul
    font_name: "Icons"
    text: md_icons.get(self.icon, md_icons["information-outline"])
    font_size: "22sp"
    size_hint: None, None
    size: dp(24), dp(24)
    text_size: self.size
    halign: "center"
    valign: "middle"
    pos_hint: {"center_y": .5}

<UiSurface@BoxLayout>:
    -bg: app.ui.tarjeta
    -stroke: app.ui.borde
    corners: [dp(app.ui.radio)]
    padding: dp(16)
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: self.bg or app.ui.fondo
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: self.corners or [dp(16)]
        Color:
            rgba: self.stroke or (0, 0, 0, 0)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(app.ui.radio))
            width: .7

<UiAction@ButtonBehavior+UiSurface>:
    size_hint_y: None
    height: dp(48)
    -bg: app.ui.suave
    -stroke: 0, 0, 0, 0
    padding: dp(14), 0
    canvas.after:
        Color:
            rgba: (0, 0, 0, .08) if self.state == "down" else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: self.corners

<UiButton@UiAction>:
    text: "Continuar"
    icon: "arrow-right"
    primary: True
    tinta: app.ui.azul
    padding: dp(12), 0
    spacing: dp(6)
    -bg: (0.157, .404, .910, 1) if self.primary else app.ui.suave
    UiIcon:
        icon: root.icon
        font_size: "20sp"
        size: dp(20), dp(22)
        -icon_color: (1, 1, 1, 1) if root.primary else root.tinta
    UiText:
        text: root.text
        -color: (1, 1, 1, 1) if root.primary else root.tinta
        bold: True
        font_size: "12sp"
        halign: "center"

<UiAvatar@UiAction>:
    size_hint: None, None
    size: dp(44), dp(44)
    corners: [dp(22)]
    -bg: .157, .404, .910, 1
    padding: 0
    AnchorLayout:
        UiIcon:
            icon: "account-outline"
            -icon_color: 1, 1, 1, 1

# Cabecera consistente con Inicio: ícono de marca, títulos y perfil.
<UiHeader@BoxLayout>:
    titulo: "EnRuta Ya!"
    subtitulo: "Tu viaje, mejor informado"
    size_hint_y: None
    height: dp(76)
    padding: dp(18), dp(10), dp(16), dp(9)
    spacing: dp(11)
    canvas.after:
        Color:
            rgba: app.ui.borde
        Line:
            points: self.x, self.y, self.right, self.y
            width: .7
    UiSurface:
        size_hint: None, None
        size: dp(42), dp(42)
        pos_hint: {"center_y": .5}
        corners: [dp(14)]
        -bg: app.ui.suave
        -stroke: 0, 0, 0, 0
        padding: 0
        AnchorLayout:
            UiIcon:
                icon: "bus-side"
                size: dp(25), dp(25)
                font_size: "23sp"
                -icon_color: app.ui.azul
    BoxLayout:
        orientation: "vertical"
        UiText:
            text: root.titulo
            bold: True
            font_size: "19sp"
        UiText:
            text: root.subtitulo
            -color: app.ui.secundario
            font_size: "10sp"
            size_hint_y: None
            height: dp(18)
    UiAvatar:
        pos_hint: {"center_y": .5}
        on_release: app.cambiar_pantalla("perfil")

# Tarjeta introductoria común a las secciones. Títulos y textos son
# propiedades configurables desde cada pantalla, sin lógica de negocio.
<UiJourneyHero@UiSurface>:
    etiqueta: "ENRUTA YA!"
    titulo: "Tu viaje, mejor informado"
    descripcion: ""
    icono: "bus-side"
    orientation: "vertical"
    size_hint_y: None
    height: dp(142)
    corners: [dp(21)]
    padding: dp(18), dp(15)
    spacing: dp(5)
    -bg: app.ui.marino
    -stroke: 0, 0, 0, 0
    BoxLayout:
        size_hint_y: None
        height: dp(24)
        spacing: dp(7)
        UiIcon:
            icon: root.icono
            size: dp(20), dp(20)
            font_size: "17sp"
            -icon_color: .64, .81, 1, 1
        UiText:
            text: root.etiqueta
            font_size: "10sp"
            bold: True
            -color: .71, .84, 1, 1
    UiText:
        text: root.titulo
        font_size: "22sp"
        bold: True
        size_hint_y: None
        height: dp(37)
        -color: 1, 1, 1, 1
    UiParagraph:
        text: root.descripcion
        font_size: "11sp"
        -color: .86, .92, 1, 1

<UiBody@MDBoxLayout>:
    orientation: "vertical"
    adaptive_height: True
    spacing: dp(12)
    padding: dp(app.ui.margen), dp(8), dp(app.ui.margen), dp(24)

<UiScroll@ScrollView>:
    do_scroll_x: False
    bar_width: dp(2)

<UiNotice@UiSurface>:
    text: ""
    icon: "information-outline"
    size_hint_y: None
    height: max(dp(60), mensaje.texture_size[1] + dp(24))
    -bg: app.ui.suave
    -stroke: 0, 0, 0, 0
    padding: dp(12)
    UiIcon:
        icon: root.icon
    UiParagraph:
        id: mensaje
        text: root.text
        -color: app.ui.texto
        font_size: "11sp"
        pos_hint: {"center_y": .5}

<UiField@MDTextField>:
    mode: "outlined"
    size_hint_y: None
    height: dp(56)
    multiline: False
    write_tab: False
    radius: [dp(12)]
    theme_text_color: "Custom"
    text_color_normal: app.ui.texto
    text_color_focus: app.ui.texto
    theme_line_color: "Custom"
    line_color_normal: app.ui.borde
    line_color_focus: app.ui.azul
    theme_bg_color: "Custom"
    fill_color_normal: app.ui.fondo
    fill_color_focus: app.ui.fondo
    error_color: app.ui.rojo
    on_text: self.error = False

<UiSwitch@MDSwitch>:
    pos_hint: {"center_y": .5}
    thumb_color_active: 1, 1, 1, 1
    thumb_color_inactive: app.ui.secundario
    track_color_active: .157, .404, .910, 1
    track_color_inactive: app.ui.borde

<UiBrand@BoxLayout>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(130)
    spacing: dp(8)
    AnchorLayout:
        size_hint_y: None
        height: dp(64)
        UiSurface:
            size_hint: None, None
            size: dp(64), dp(64)
            -bg: .157, .404, .910, 1
            -stroke: 0, 0, 0, 0
            padding: 0
            AnchorLayout:
                UiIcon:
                    icon: "bus-side"
                    font_size: "32sp"
                    size: dp(36), dp(36)
                    -icon_color: 1, 1, 1, 1
    UiText:
        text: "EnRuta Ya!"
        font_size: "28sp"
        bold: True
        halign: "center"
    UiText:
        text: "Viaja con información de la comunidad"
        font_size: "11sp"
        -color: app.ui.secundario
        halign: "center"
        size_hint_y: None
        height: dp(18)
